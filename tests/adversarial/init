#!/bin/sh
# init - PID 1 for the adversarial suite (adversarial/run.sh).
#
# It drives the module through the operator surface, then hands the wire and
# the public port to /bin/adv_probe, which attacks from outside.  Every attack
# prints ADV_RESULT <name> <PASS|FAIL|SKIP> <detail>; the host runner turns
# those lines into the table.
#
# The phases are selected by /adv-phases.txt, one or more names per line:
#   public control resource slab final replay rmmod flush param near far
# run.sh boots one guest per group, so a phase that hangs the kernel cannot
# hide the results of the phases that ran before it.  Each phase prints
# PHASE_START/PHASE_END; the host reports a started-but-not-ended phase as a
# hang.
set -u

CFG=/proc/net/tbtun/config
PORTS=/proc/net/tbtun/ports
PUB=19100
CAR=19101
FAKE=19102
TGT=19070
# Dedicated listen ports for the contract/carrier phases.  They are separate
# tunnels so a failure in one attack cannot poison the next.
CAR_NONCE=19110
CAR_ANCHOR=19111
CAR_OVERLAP=19112
CAR_SECOND=19113
FAKE_FIN=19120
PUB_FIN=19121
# Close-drain: a bulk stream and a short control stream on one carrier.
SINK=19073
CDPUB=19130

PHASES=$(cat /adv-phases.txt 2> /dev/null)
[ -n "$PHASES" ] || PHASES="public control resource slab final replay rmmod flush param near far"
want() {
    case " $PHASES " in
    *" $1 "*) return 0 ;;
    esac
    return 1
}

res() {
    echo "ADV_RESULT $1 $2 $3"
}

flush_all() {
    echo flush > "$CFG" 2> /dev/null || true
    sleep 1
}

# Reap a background job, but not for longer than N seconds.  `kill -0` is not
# usable here: a finished child stays a zombie until wait() and still answers
# kill -0, so polling would always time out.
wait_timeout() { # pid seconds
    ( sleep "$2"; kill -9 "$1" 2> /dev/null ) &
    _w=$!
    wait "$1"
    _rc=$?
    kill "$_w" 2> /dev/null
    return $_rc
}

# A stream torn down by the module must reach the application as EOF or a
# reset, not as a timeout.  EAGAIN (11) means the socket stayed open with
# nothing driving it.
clean_abort() { # output-file
    _o=$(cat "$1" 2> /dev/null)
    case $_o in
    ECHO_EOF*) return 0 ;;
    *"errno=104"* | *"errno=32"* | *"errno=103"*) return 0 ;;
    esac
    return 1
}

setup_raw() {
    flush_all
    echo "tunnel 1 role=far profile=raw listen=127.0.0.1:$CAR target=127.0.0.1:$TGT n=1 m=0" \
        > "$CFG" || res init.setup FAIL "far tunnel rejected"
    echo "tunnel 2 role=near profile=raw listen=127.0.0.1:$PUB peer=127.0.0.1:$CAR n=1 m=0" \
        > "$CFG" || res init.setup FAIL "near tunnel rejected"
    sleep 1
}

echo_check() { # name mib
    _out=$(timeout 60 /bin/adv_probe echo "$PUB" "$2" 0 2>&1)
    case $_out in
    ECHO_OK*)
        res "$1" PASS "$_out"
        ;;
    *)
        res "$1" FAIL "$_out"
        ;;
    esac
}

# --- boot ------------------------------------------------------------------
export PATH=/bin

mkdir -p /proc /sys /dev /tmp
mount -t proc proc /proc || { echo "TBT_ADV_FATAL mount /proc"; poweroff -f; }
mount -t sysfs sysfs /sys 2> /dev/null
mount -t devtmpfs devtmpfs /dev 2> /dev/null || mount -t ramfs ramfs /dev
mount -t tmpfs tmpfs /tmp 2> /dev/null
/bin/busybox ip link set lo up 2> /dev/null ||
    /bin/busybox ifconfig lo 127.0.0.1 up 2> /dev/null
/bin/busybox ifconfig lo 2> /dev/null | grep -q 127.0.0.1 || {
    echo "TBT_ADV_FATAL no loopback"
    poweroff -f
}

echo "== tbtun adversarial guest: $(uname -r) phases=$PHASES"
insmod /tbtun.ko debug=1 || {
    echo "TBT_ADV_FATAL insmod failed"
    poweroff -f
}
grep -q '^tbtun ' /proc/modules || {
    echo "TBT_ADV_FATAL tbtun not loaded"
    poweroff -f
}
[ -e "$CFG" ] || {
    echo "TBT_ADV_FATAL $CFG missing"
    poweroff -f
}
echo 'ports 40000-41023' > "$PORTS" 2> /dev/null

# A deterministic echo target: it echoes until EOF and then closes, so the
# half-close test measures the tunnel, not busybox nc's close semantics.
/bin/adv_probe target "$TGT" > /dev/null 2>&1 &
sleep 1
dmesg -c > /dev/null 2>&1 || true
# The module logs every accepted carrier at KERN_INFO.  At console loglevel 7
# that printk interleaves with the user-space ADV_RESULT lines on the same
# serial port and splits them.  dmesg still records everything; only the
# console is quieted.  A group that hangs loses its dmesg, so the host also
# scans the console for BUG/Oops lines.
echo 3 > /proc/sys/kernel/printk 2> /dev/null || dmesg -n 3 2> /dev/null || true

# --- phases ----------------------------------------------------------------

phase_public() {
    echo "== public port"
    setup_raw
    echo_check init.echo_sane 2

    setup_raw
    # 10 000 cycles at the measured 185 ms/cycle is about 31 minutes.  The
    # old 150 s budget killed the probe before it could print its verdict.
    timeout 2400 /bin/adv_probe churn "$PUB" 10000
    case $? in
    124 | 143) res init.churn TIMEOUT "10k connect/close did not finish" ;;
    esac

    setup_raw
    timeout 30 /bin/adv_probe two "$PUB"

    # P3b3 acceptance: 100 concurrent public connections on the same near
    # tunnel.  All 100 are established before any payload; each sends 4096 B
    # and must read the same bytes back; then all close.  Closing one stream
    # must not disturb another, every stream must be released, and the tunnel
    # must still accept a fresh connection.
    setup_raw
    timeout 120 /bin/adv_probe concurrent "$PUB" 100 4096 60 1
    case $? in
    124 | 143) res pub.concurrent TIMEOUT "adv_probe concurrent did not finish in 120s" ;;
    esac
    echo "CONC_STATS_BEGIN"
    cat /proc/net/tbtun/stats 2> /dev/null
    cat /proc/net/tbtun/tunnels 2> /dev/null
    echo "CONC_STATS_END"

    setup_raw
    timeout 30 /bin/adv_probe halfclose "$PUB"

    setup_raw
    timeout 30 /bin/adv_probe rst "$PUB" 4

    # F8 contract: `src=` is gone.  The tunnel identity is the session nonce
    # (`nonce=`), which must be accepted and rendered back by the canonical
    # config; a short nonce is refused.  The data-path half of this contract
    # is phase srcfilter.
    if echo "tunnel 9 role=near profile=raw listen=127.0.0.1:$((PUB + 9)) peer=127.0.0.1:19199 n=1 m=0 src=127.0.0.0/8" \
        > "$CFG" 2> /dev/null; then
        res init.src_key FAIL "src= is still accepted; the inbound allow list was deleted"
        echo 'del 9' > "$CFG" 2> /dev/null
    else
        _n=00112233445566778899aabbccddeeff
        if echo "tunnel 9 role=near profile=raw listen=127.0.0.1:$((PUB + 9)) peer=127.0.0.1:19199 n=1 m=0 nonce=$_n" \
            > "$CFG" 2> /dev/null; then
            _line=$(awk '$1 == "tunnel" && $2 == 9' "$CFG")
            case $_line in
            *"nonce=$_n"*)
                if echo "tunnel 9 role=near profile=raw listen=127.0.0.1:$((PUB + 9)) peer=127.0.0.1:19199 n=1 m=0 nonce=0011" \
                    > "$CFG" 2> /dev/null; then
                    res init.src_key FAIL "a 2-byte nonce= was accepted"
                else
                    res init.src_key PASS "src= refused; nonce= accepted and rendered; short nonce= refused"
                fi
                ;;
            *)
                res init.src_key FAIL "nonce= was accepted but not rendered: $_line"
                ;;
            esac
        else
            res init.src_key FAIL "nonce= is not a tunnel key"
        fi
        echo 'del 9' > "$CFG" 2> /dev/null
    fi

    setup_raw
    timeout 90 /bin/adv_probe writer "$PUB" 100 0
    flush_all

    setup_raw
    timeout 120 /bin/adv_probe writer "$PUB" 1024 0
    flush_all

    # The other half of writer standard 7: with a reader draining the echo
    # the same bytes must come back, not merely block.
    writer_drain_cases
}

phase_control() {
    echo "== control surface"
    setup_raw
    _cfg_before=$(cat "$CFG")
    timeout 10 /bin/adv_probe nonroot "$CFG"
    _cfg_after=$(cat "$CFG")
    [ "$_cfg_before" = "$_cfg_after" ] &&
        res init.nonroot_unchanged PASS "config unchanged after the uid-1000 attempt" ||
        res init.nonroot_unchanged FAIL "config changed after the uid-1000 attempt"

    timeout 10 /bin/adv_probe cfgwrite "$CFG" 513
    timeout 10 /bin/adv_probe cfgwrite "$CFG" 512
    timeout 10 /bin/adv_probe cfgwrite "$CFG" 512nonl
    timeout 10 /bin/adv_probe cfgwrite "$CFG" 1025
    timeout 10 /bin/adv_probe cfgwrite "$CFG" 1024nonl
    _cfg_after=$(cat "$CFG")
    [ "$_cfg_before" = "$_cfg_after" ] &&
        res init.cfg_unchanged PASS "over-long lines changed nothing" ||
        res init.cfg_unchanged FAIL "an over-long line changed the config"

    # review 31: a valid line buffered without a newline, then a write that
    # overflows the 1024-byte line buffer. The write must report -E2BIG and
    # the release-time drain must discard the tail instead of applying its
    # prefix as if the line had completed.
    timeout 10 /bin/adv_probe overflow "$CFG"

    # The documented round-trip: read the canonical config, write every line
    # back.  No transfer here; the concurrent case is phase replay.
    cat "$CFG" > /tmp/cfg.save
    RC=0
    while IFS= read -r _line; do
        printf '%s\n' "$_line" > "$CFG" 2> /dev/null || RC=1
    done < /tmp/cfg.save
    [ "$RC" -eq 0 ] &&
        res init.cfg_roundtrip PASS "the canonical config replays line by line" ||
        res init.cfg_roundtrip FAIL "a canonical config line was rejected (the far tunnel renders peer=0.0.0.0:0, which the parser refuses: port must be 1..65535)"
    setup_raw
    echo_check init.echo_after_roundtrip 1
}

phase_resource() {
    echo "== resource limits"
    flush_all
    _i=0
    while [ "$_i" -lt 80 ]; do
        echo "tunnel $((100 + _i)) role=far profile=raw listen=127.0.0.1:$((22000 + _i)) target=127.0.0.1:$TGT n=1 m=0" \
            > "$CFG" 2> /dev/null || break
        _i=$((_i + 1))
    done
    _n=$(grep -vc '^#' /proc/net/tbtun/tunnels 2> /dev/null)
    if [ "$_n" -ge 80 ]; then
        res init.max_tunnels FAIL "80 tunnels accepted although max_tunnels=64 (documented limit not enforced)"
    else
        res init.max_tunnels PASS "$_n tunnels accepted before the limit"
    fi
    flush_all

    # 32 near/far pairs with 16 carriers each (the documented maxima).
    flush_all
    echo 'ports 40000-41023' > "$PORTS"
    _mem0=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
    _i=0
    while [ "$_i" -lt 32 ]; do
        echo "tunnel $((300 + _i)) role=far profile=raw listen=127.0.0.1:$((23000 + _i)) target=127.0.0.1:$TGT n=16 m=0" \
            > "$CFG" 2> /dev/null || res init.scale_create FAIL "far $((300 + _i)) rejected"
        _i=$((_i + 1))
    done
    _i=0
    while [ "$_i" -lt 32 ]; do
        echo "tunnel $((400 + _i)) role=near profile=raw listen=127.0.0.1:$((24000 + _i)) peer=127.0.0.1:$((23000 + _i)) n=16 m=0" \
            > "$CFG" 2> /dev/null || res init.scale_create FAIL "near $((400 + _i)) rejected"
        _i=$((_i + 1))
    done
    sleep 8
    _up=$(awk '$8 == "up" {n++} END {print n + 0}' /proc/net/tbtun/peers)
    _all=$(grep -vc '^#' /proc/net/tbtun/peers)
    _mem1=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
    if [ "$_up" -ge 400 ]; then
        res init.scale PASS "$_up carriers up of $_all rows; MemAvailable ${_mem0} -> ${_mem1} kB"
    else
        res init.scale FAIL "only $_up carriers up of $_all rows; MemAvailable ${_mem0} -> ${_mem1} kB"
    fi
    flush_all

}

phase_port() {
    echo "== port block exhaustion"
    flush_all
    echo 'ports 40000-40015' > "$PORTS"
    echo "tunnel 1 role=far profile=raw listen=127.0.0.1:$CAR target=127.0.0.1:$TGT n=1 m=0" > "$CFG"
    echo "tunnel 2 role=near profile=raw listen=127.0.0.1:$PUB peer=127.0.0.1:$CAR n=16 m=0" > "$CFG"
    sleep 1
    echo "tunnel 3 role=near profile=raw listen=127.0.0.1:$((PUB + 3)) peer=127.0.0.1:$CAR n=16 m=0" > "$CFG" 2> /dev/null
    sleep 2
    _has3=$(grep -c '^3 ' /proc/net/tbtun/tunnels 2> /dev/null)
    _fail=$(awk '$1 == "tunnel" && $2 == 3 {for (i = 1; i <= NF; i++) if (index($i, "alloc_fail=") == 1) {split($i, a, "="); print a[2]}}' /proc/net/tbtun/stats)
    # A silent alloc_fail= is the defect, not the proof: the operator needs a
    # reason.  Either the tunnel is refused at write time (the all-or-nothing
    # admission), or a dedicated counter/log names the exhausted port block.
    _vis=$(grep -oE '(port_alloc_fail|port_exhaust|port_retry|degraded)=[0-9]+' /proc/net/tbtun/stats 2> /dev/null |
        grep -vE '=0$' | head -n 4 | tr '\n' ' ')
    _log=$(dmesg 2> /dev/null | grep -ciE 'port block exhausted|no free port|port .*exhaust' || true)
    if [ "$_has3" -eq 0 ]; then
        res init.port_exhaust PASS "tunnel 3 was refused (no row in tunnels); alloc_fail=${_fail:-none}; visible=${_vis:-none}; log lines=$_log"
    elif [ -n "$_vis" ]; then
        res init.port_exhaust PASS "tunnel 3 accepted but the exhaustion is operator-visible: $_vis (alloc_fail=$_fail, log lines=$_log)"
    elif [ "$_log" -gt 0 ]; then
        res init.port_exhaust PASS "tunnel 3 accepted but the kernel log names the exhausted port block ($_log lines, alloc_fail=$_fail)"
    else
        res init.port_exhaust FAIL "port block exhausted: tunnel 3 accepted, alloc_fail=$_fail, no port_alloc_fail/port_exhaust/port_retry/degraded counter and no log line"
    fi
    # No flush: this group's purpose is the result above, and teardown is a
    # separate (hanging) test.
}

phase_slab() {
    echo "== slab growth"
    flush_all
    # This kernel has no dedicated 32k cache; the carrier objects and their
    # HTTP buffers come from the kmalloc caches (named kmalloc-Nk, or the
    # kmalloc-rnd-NN-k buckets this config builds).  Count every kmalloc
    # object and byte instead of naming one cache: a per-connection leak
    # lands in that total no matter which size class the allocator picked.
    _slab_objs() {
        _v=$(awk '$1 ~ /^kmalloc/ {s += $2} END {print s + 0}' /proc/slabinfo 2> /dev/null)
        case $_v in
        '' | *[!0-9]*) echo 0 ;;
        *) echo "$_v" ;;
        esac
    }
    _slab_bytes() {
        _v=$(awk '$1 ~ /^kmalloc/ {s += $2 * $4} END {print s + 0}' /proc/slabinfo 2> /dev/null)
        case $_v in
        '' | *[!0-9]*) echo 0 ;;
        *) echo "$_v" ;;
        esac
    }
    if [ ! -r /proc/slabinfo ]; then
        res init.slab_leak SKIP "/proc/slabinfo is not readable; kmalloc growth cannot be measured"
        res init.slab_after_flush SKIP "/proc/slabinfo is not readable; kmalloc release cannot be measured"
        flush_all
        return
    fi
    _idle=$(_slab_objs)
    if [ "${_idle:-0}" -eq 0 ]; then
        res init.slab_leak SKIP "/proc/slabinfo names no kmalloc caches; kmalloc growth cannot be measured"
        res init.slab_after_flush SKIP "/proc/slabinfo names no kmalloc caches; kmalloc release cannot be measured"
        flush_all
        return
    fi
    echo "tunnel 1 role=far profile=http-kal listen=127.0.0.1:$CAR target=127.0.0.1:$TGT n=4 m=0" \
        > "$CFG"
    sleep 1
    # The far session's own allocations are not part of the per-connection
    # growth: take the baseline after the tunnel is up, and compare the
    # post-flush count with the idle count from before the tunnel existed.
    _s0=$(_slab_objs)
    _b0=$(_slab_bytes)
    _gout=$(timeout 120 /bin/adv_probe garbage "$CAR" 100 2>&1)
    _grc=$?
    printf '%s\n' "$_gout"
    if [ "$_grc" -ne 0 ] || ! printf '%s\n' "$_gout" | grep -q '^GARBAGE_DONE '; then
        res init.slab_leak SKIP "the garbage probe did not complete (rc=$_grc); kmalloc growth cannot be measured"
        res init.slab_after_flush SKIP "the garbage probe did not complete (rc=$_grc); kmalloc release cannot be measured"
        flush_all
        return
    fi
    _gclosed=$(printf '%s\n' "$_gout" |
        sed -n 's/^GARBAGE_DONE n=[0-9]* closed=\([0-9][0-9]*\)$/\1/p' | tail -1)
    case $_gclosed in
    '' | *[!0-9]*) _gclosed=0 ;;
    esac
    if [ "$_gclosed" -lt 50 ]; then
        res init.slab_leak SKIP "only $_gclosed of 100 garbage connections closed; kmalloc growth cannot be attributed to a per-connection leak"
        res init.slab_after_flush SKIP "only $_gclosed of 100 garbage connections closed; kmalloc release cannot be measured"
        flush_all
        return
    fi
    sleep 2
    _s1=$(_slab_objs)
    _b1=$(_slab_bytes)
    if [ "$_s1" -eq 0 ]; then
        res init.slab_leak SKIP "/proc/slabinfo stopped naming kmalloc caches during the measurement"
        res init.slab_after_flush SKIP "/proc/slabinfo stopped naming kmalloc caches during the measurement"
        flush_all
        return
    fi
    _grew=$((_s1 - _s0))
    _grewb=$((_b1 - _b0))
    echo "SLAB kmalloc_objects before=$_s0 after=$_s1 delta=$_grew bytes_delta=$_grewb"
    if [ "$_grew" -ge 50 ]; then
        res init.slab_leak FAIL "100 unauthenticated garbage connections (closed=$_gclosed) grew the kmalloc caches by $_grew objects ($_grewb bytes); a per-connection carrier object is not freed"
    else
        res init.slab_leak PASS "100 unauthenticated garbage connections (closed=$_gclosed) grew the kmalloc caches by $_grew objects ($_grewb bytes, threshold 50)"
    fi
    flush_all
    sleep 2
    _s2=$(_slab_objs)
    if [ "$_s2" -eq 0 ]; then
        res init.slab_after_flush SKIP "/proc/slabinfo stopped naming kmalloc caches after the flush"
        flush_all
        return
    fi
    _d2=$((_s2 - _idle))
    echo "SLAB kmalloc_objects after_flush=$_s2 idle=$_idle delta=$_d2"
    if [ "$_d2" -ge 50 ]; then
        res init.slab_after_flush FAIL "flush left $_d2 kmalloc objects above the pre-test idle baseline ($_idle -> $_s2); session teardown did not release them"
    else
        res init.slab_after_flush PASS "flush returned the kmalloc object count to the idle baseline ($_idle -> $_s2, delta $_d2, threshold 50)"
    fi
}

phase_final() {
    echo "== final sanity"
    flush_all
    setup_raw
    echo_check init.final_echo 4

    _bad=$(dmesg | grep -cE 'WARNING:|BUG:|Oops|INFO: task|general protection fault|Call Trace:|deprecated workqueue|refcount_t:|KASAN')
    if [ "$_bad" -eq 0 ]; then
        res init.dmesg PASS "no WARNING/BUG/Oops/INFO: task in the guest log"
    else
        res init.dmesg FAIL "$_bad kernel warning/BUG/oops lines; see the console"
        dmesg | grep -E 'WARNING:|BUG:|Oops|INFO: task|general protection fault|Call Trace:|deprecated workqueue|refcount_t:|KASAN' | tail -n 20
    fi
}

phase_replay() {
    echo "== config replay mid-transfer"
    setup_raw
    timeout 60 /bin/adv_probe echo "$PUB" 8 20 > /tmp/echo_replay.out 2>&1 &
    EP=$!
    sleep 1
    cat "$CFG" > /tmp/cfg.save
    RC=0
    while IFS= read -r _line; do
        printf '%s\n' "$_line" > "$CFG" 2> /dev/null || RC=1
    done < /tmp/cfg.save
    wait_timeout "$EP" 10
    if [ $? -ne 137 ] && clean_abort /tmp/echo_replay.out; then
        res init.cfg_replay PASS "line-by-line config replay rc=$RC, transfer closed cleanly: $(cat /tmp/echo_replay.out)"
    else
        res init.cfg_replay FAIL "config replay rc=$RC, no clean transfer close: $(cat /tmp/echo_replay.out 2> /dev/null)"
    fi
    setup_raw
    echo_check init.echo_after_replay 1
}

phase_rmmod() {
    echo "== rmmod mid-transfer"
    flush_all
    setup_raw
    timeout 60 /bin/adv_probe echo "$PUB" 8 20 > /tmp/echo_rmmod.out 2>&1 &
    EP=$!
    sleep 1
    timeout 15 rmmod tbtun
    RC=$?
    wait_timeout "$EP" 8
    [ $? -eq 137 ] && _app=hung || _app=exited
    if [ "$RC" -eq 0 ] && [ "$_app" = exited ] && clean_abort /tmp/echo_rmmod.out; then
        res init.rmmod PASS "rmmod rc=0, app closed cleanly: $(cat /tmp/echo_rmmod.out)"
    else
        res init.rmmod FAIL "rmmod rc=$RC, app $_app, no clean close: $(cat /tmp/echo_rmmod.out 2> /dev/null)"
    fi
    insmod /tbtun.ko debug=1 2> /dev/null || res init.reload FAIL "insmod after rmmod failed"
    [ -e "$CFG" ] && res init.reload PASS "module reloaded" || res init.reload FAIL "no $CFG"
    sleep 1
    _bad=$(dmesg | grep -cE 'WARNING:|BUG:|Oops|INFO: task|general protection fault|Call Trace:|deprecated workqueue|refcount_t:|KASAN')
    if [ "$_bad" -eq 0 ]; then
        res init.dmesg_after_rmmod PASS "no warning/BUG/oops after rmmod"
    else
        res init.dmesg_after_rmmod FAIL "$_bad warning/BUG/oops lines after rmmod"
        dmesg | grep -E 'WARNING:|BUG:|Oops|INFO: task|general protection fault|Call Trace:|deprecated workqueue|refcount_t:|KASAN' | tail -n 30
    fi
}

phase_flush() {
    echo "== flush mid-transfer"
    flush_all
    setup_raw
    timeout 60 /bin/adv_probe echo "$PUB" 8 20 > /tmp/echo_flush.out 2>&1 &
    EP=$!
    sleep 1
    echo flush > "$CFG"
    wait_timeout "$EP" 6
    if [ $? -ne 137 ] && clean_abort /tmp/echo_flush.out; then
        res init.flush_midstream PASS "flush mid-transfer: app closed cleanly, $(cat /tmp/echo_flush.out)"
    else
        res init.flush_midstream FAIL "flush mid-transfer: no clean close: $(cat /tmp/echo_flush.out 2> /dev/null)"
    fi
    # The documented recovery after a flush is to configure the tunnel again
    # and reconnect.  A teardown that leaves the listener or the port block
    # wedged shows up here, not in the app's close.
    setup_raw
    echo_check init.echo_after_flush 1
    flush_all
}

# The two pub.writer cases alone.  They live in phase_public too; this phase
# exists so the backpressure budget can be re-run without the 10k-cycle churn
# (about 31 minutes) that precedes them.
phase_writer() {
    echo "== pub.writer backpressure"
    setup_raw
    timeout 120 /bin/adv_probe writer "$PUB" 100 0
    setup_raw
    timeout 180 /bin/adv_probe writer "$PUB" 1024 0
    flush_all
}

# pub.halfclose alone: the public group's 10k-cycle churn takes about 31
# minutes and is unrelated to the half-close contract.
phase_halfclose() {
    echo "== pub.halfclose"
    setup_raw
    timeout 30 /bin/adv_probe halfclose "$PUB"
    flush_all
}

# --- config larger than 32 KiB (review 19/30) ------------------------------

# The canonical line is maximal in every scalar: 64 of them are 34,487 bytes,
# past the old 32 KiB TBT_CFG_RENDER_MAX. `id` and the listen port are the
# only per-tunnel values; every other field is at its parser maximum, the
# 8-entry srcaddrs list is exactly the 127-byte parse limit, and
# tx_window_bytes=0 is the renderer's default (auto) in the position the
# renderer prints it.  The probe compares this input with the render
# byte-for-byte, so a new renderer field must be added here too.
bigcfg_lines() {
    awk 'BEGIN {
        for (i = 1; i <= 64; i++)
            printf "tunnel %d role=far listen=127.0.0.1:%d target=255.255.255.255:65535 peer=255.255.255.255:65535 n=16 m=0 dup=3 profile=http-kal-drip keepalive=86400000 drip_ms=3600000 replay=268435456 tunnel_rate=4294967295 max_inflate=1000.000 hole_budget_ms=60000 rx_reorder_bytes=268435456 tx_window_bytes=0 tx_retain_bytes=4294967295 carrier_stall_ms=3600000 portblock=0-0 nonce=00112233445566778899aabbccddeeff srcaddrs=255.255.255.255,255.255.255.255,255.255.255.255,255.255.255.255,255.255.255.255,255.255.255.255,255.255.255.255,255.255.255.255\n", i, 22000 + i
    }'
}

phase_bigcfg() {
    echo "== config larger than 32 KiB"
    flush_all
    bigcfg_lines > /tmp/big.lines
    _want=$(wc -c < /tmp/big.lines | tr -d ' ')
    cat /tmp/big.lines > "$CFG" 2> /tmp/big.err
    RC=$?
    _n=$(grep -vc '^#' /proc/net/tbtun/tunnels 2> /dev/null)
    if [ "$RC" -eq 0 ] && [ "$_n" -eq 64 ]; then
        res cfg.big_write PASS "wrote $_want bytes / 64 maximal tunnel lines, rc=0"
    else
        res cfg.big_write FAIL "write rc=$RC, $_n tunnels (want 64), $_want bytes: $(cat /tmp/big.err)"
    fi
    timeout 30 /bin/adv_probe cfgbig "$CFG" /tmp/big.lines
    case $? in
    124 | 143) res cfg.big_roundtrip TIMEOUT "adv_probe cfgbig did not finish in 30s" ;;
    esac
    # The documented backup/restore: read the render, flush, write it back.
    cat "$CFG" > /tmp/big.save 2> /dev/null
    flush_all
    cat /tmp/big.save > "$CFG" 2> /tmp/big.replay.err
    RC=$?
    _n=$(grep -vc '^#' /proc/net/tbtun/tunnels 2> /dev/null)
    _got=$(cat "$CFG" 2> /dev/null | wc -c | tr -d ' ')
    if [ "$RC" -eq 0 ] && [ "$_n" -eq 64 ] && [ "$_got" -eq "$_want" ]; then
        res cfg.big_replay PASS "cat render > config after flush: rc=0, 64 tunnels, $_got bytes re-rendered"
    else
        res cfg.big_replay FAIL "replay rc=$RC, $_n tunnels, $_got bytes (want 64, $_want): $(cat /tmp/big.replay.err)"
    fi
    flush_all
    setup_raw
    echo_check cfg.echo_after_big 1
}

