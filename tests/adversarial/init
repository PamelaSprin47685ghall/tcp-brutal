phase_catconfig() {
    echo "== cat config > config"
    flush_all
    echo "tunnel 1 role=far profile=raw listen=127.0.0.1:$CAR target=127.0.0.1:$TGT n=1 m=0" \
        > "$CFG"
    echo "tunnel 2 role=near profile=raw listen=127.0.0.1:$PUB peer=127.0.0.1:$CAR n=1 m=0" \
        > "$CFG"
    sleep 1
    # The documented save/restore in one command: read the canonical config
    # and write it back to the same file.  The far line is the interesting
    # one (it used to render peer=0.0.0.0:0 and be rejected).
    _out=$(timeout 10 sh -c "cat $CFG > $CFG" 2>&1)
    RC=$?
    _n=$(grep -vc '^#' /proc/net/tbtun/tunnels 2> /dev/null)
    if [ "$RC" -eq 0 ] && [ "$_n" -ge 2 ]; then
        res cat.cfg_self PASS "cat config > config rc=0, $_n tunnels still present: $_out"
    else
        res cat.cfg_self FAIL "cat config > config rc=$RC, $_n tunnels: $_out"
    fi
    setup_raw
    echo_check init.echo_after_cat 1
}

phase_cfg_mix() {
    echo "== rejected line followed by a far line"
    flush_all
    # One write, two lines: line 1 is invalid, line 2 is a far tunnel.  The
    # parser must consume line 1, keep the error, and still apply line 2;
    # the line buffer must not retain a tail for the close flush.
    printf 'tunnel 1 role=bogus listen=127.0.0.1:1 target=127.0.0.1:2\ntunnel 2 role=far profile=raw listen=127.0.0.1:19104 target=127.0.0.1:%s n=1 m=0\n' "$TGT" \
        > "$CFG" 2> /dev/null
    RC=$?
    _has2=$(grep -c '^2 ' /proc/net/tbtun/tunnels 2> /dev/null)
    _has1=$(grep -c '^1 ' /proc/net/tbtun/tunnels 2> /dev/null)
    # The shell's printf exit status does not reliably carry a proc write
    # error; the config effect does.  The bad line must leave no tunnel 1,
    # and the following far line must be applied.
    if [ "$_has2" -ge 1 ] && [ "$_has1" -eq 0 ]; then
        res cat.cfg_mix PASS "bad line not applied, far line applied (write rc=$RC)"
    else
        res cat.cfg_mix FAIL "write rc=$RC, tunnel 1 present=$_has1, tunnel 2 present=$_has2 (expected 0 and 1)"
    fi
}

