# The near's own counters are the evidence for "did the carrier read the acks"
# and "did the stream die".  Printed before the tunnel is flushed.
dump_stats() {
    echo "NEARX_STATS_BEGIN"
    cat /proc/net/tbtun/stats 2> /dev/null
    cat /proc/net/tbtun/peers 2> /dev/null
    echo "NEARX_STATS_END"
}

phase_nearx() {
    echo "== near FIN/RST under carrier backpressure"
    # The fake far stops reading (a 4 KiB receive buffer and no drain), the
    # application writes 4 MiB and then half-closes or resets.  The near's
    # carrier send queue is full when the pinned FIN/RST is queued; the
    # verdict is whether the frame still reaches the far.  The explicit
    # 8 MiB window (equal to the default rx_reorder_bytes, so the parser
    # accepts it) lets the near admit the whole write instead of deriving a
    # smaller BDP window (auto is capped by rx_reorder_bytes); the one-hour
    # stall timer keeps a slow fill from being read as a dead carrier.
    flush_all
    timeout 100 /bin/adv_probe fineagain "$FAKE_FIN" "$PUB_FIN" 2 fin > /tmp/fin_eagain.out 2>&1 &
    _fp=$!
    sleep 1
    if echo "tunnel 2 role=near profile=raw listen=127.0.0.1:$PUB_FIN peer=127.0.0.1:$FAKE_FIN n=1 m=0 tx_window_bytes=8388608 carrier_stall_ms=3600000" \
        > "$CFG" 2> /dev/null; then
        wait_timeout "$_fp" 90
        [ $? -eq 137 ] && res near.fin_eagain TIMEOUT "the FIN backpressure probe did not finish"
        cat /tmp/fin_eagain.out
        dump_stats
    else
        kill -9 "$_fp" 2> /dev/null
        res near.fin_eagain FAIL "the near tunnel was rejected"
    fi

    flush_all
    timeout 100 /bin/adv_probe fineagain "$FAKE_FIN" "$PUB_FIN" 2 rst > /tmp/rst_eagain.out 2>&1 &
    _fp=$!
    sleep 1
    if echo "tunnel 2 role=near profile=raw listen=127.0.0.1:$PUB_FIN peer=127.0.0.1:$FAKE_FIN n=1 m=0 tx_window_bytes=8388608 carrier_stall_ms=3600000" \
        > "$CFG" 2> /dev/null; then
        wait_timeout "$_fp" 90
        [ $? -eq 137 ] && res near.rst_eagain TIMEOUT "the RST backpressure probe did not finish"
        cat /tmp/rst_eagain.out
        dump_stats
    else
        kill -9 "$_fp" 2> /dev/null
        res near.rst_eagain FAIL "the near tunnel was rejected"
    fi
    flush_all
}

phase_far() {
    echo "== hostile carrier (http-kal, far side)"
    flush_all
    echo "tunnel 1 role=far profile=http-kal listen=127.0.0.1:$CAR target=127.0.0.1:$TGT n=4 m=0" \
        > "$CFG" || res init.far_setup FAIL "far tunnel rejected"
