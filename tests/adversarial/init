phase_farx() {
    echo "== far contract, overlap, second carrier"
    # 1. nonce= pins the session nonce and the first authenticated source.
    flush_all
    if echo "tunnel 5 role=far profile=http-kal listen=127.0.0.1:$CAR_NONCE target=127.0.0.1:$TGT n=4 m=0 nonce=00112233445566778899aabbccddeeff" \
        > "$CFG" 2> /dev/null; then
        sleep 1
        timeout 40 /bin/adv_probe noncepinned "$CAR_NONCE" 5
        case $? in
        124 | 143) res far.nonce_pinned TIMEOUT "the pinned-nonce probe did not finish" ;;
        esac
    else
        res far.nonce_pinned FAIL "the far line with nonce= was rejected by the grammar"
    fi

    # 2. peer= anchors the only near source allowed to join, and must render.
    flush_all
    if echo "tunnel 6 role=far profile=http-kal listen=127.0.0.1:$CAR_ANCHOR target=127.0.0.1:$TGT n=4 m=0 peer=127.0.0.1:1" \
        > "$CFG" 2> /dev/null; then
        sleep 1
        timeout 40 /bin/adv_probe srcanchor "$CAR_ANCHOR" 6
        case $? in
        124 | 143) res far.src_anchor TIMEOUT "the source-anchor probe did not finish" ;;
        esac
    else
        res far.src_anchor FAIL "the far line with peer= was rejected by the grammar"
    fi

    # 3. Overlapping reorder frames on an authenticated carrier.
    flush_all
    echo "tunnel 7 role=far profile=http-kal listen=127.0.0.1:$CAR_OVERLAP target=127.0.0.1:$TGT n=4 m=0 rx_reorder_bytes=32768" \
        > "$CFG" || res far.overlap FAIL "far tunnel rejected"
    sleep 1
    timeout 60 /bin/adv_probe overlap "$CAR_OVERLAP" 7
    case $? in
    124 | 143) res far.overlap TIMEOUT "the overlap probe did not finish" ;;
    esac

    # 4. A second carrier after the first is established (F6).
    flush_all
    echo "tunnel 8 role=far profile=http-kal listen=127.0.0.1:$CAR_SECOND target=127.0.0.1:$TGT n=4 m=0" \
        > "$CFG" || res far.second_carrier FAIL "far tunnel rejected"
    sleep 1
    timeout 40 /bin/adv_probe secondcarrier "$CAR_SECOND" 8
    case $? in
    124 | 143) res far.second_carrier TIMEOUT "the second-carrier probe did not finish" ;;
    esac
    flush_all
}

phase_srcfilter() {
    echo "== pinned nonce and far anchor on the public path"
    flush_all
    _n=00112233445566778899aabbccddeeff
    if echo "tunnel 1 role=far profile=raw listen=127.0.0.1:$CAR target=127.0.0.1:$TGT n=1 m=0 nonce=$_n peer=127.0.0.1:1" \
        > "$CFG" 2> /dev/null; then
        if echo "tunnel 2 role=near profile=raw listen=127.0.0.1:$PUB peer=127.0.0.1:$CAR n=1 m=0 nonce=$_n" \
            > "$CFG" 2> /dev/null; then
