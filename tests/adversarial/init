# --- tunnel creation failure on a held listen port (review 3) --------------

phase_create() {
    echo "== tunnel create failure on a held listen port"
    flush_all
    setup_raw
    _out=$(timeout 60 /bin/adv_probe echo "$PUB" 1 0 2>&1)
    case $_out in
    ECHO_OK*) res create.baseline PASS "$_out" ;;
    *) res create.baseline FAIL "$_out" ;;
    esac

    /bin/adv_probe target 19199 > /tmp/holder.out 2>&1 &
    HOLD=$!
    sleep 1
    if ! grep -q TARGET_READY /tmp/holder.out; then
        res create.failure FAIL "the holder did not bind 19199: $(cat /tmp/holder.out)"
        kill "$HOLD" 2> /dev/null
        return
    fi

    # (a) A new id on the held port: the create must fail visibly and leave
    # the running tunnels untouched.
    if echo "tunnel 9 role=far profile=raw listen=127.0.0.1:19199 target=127.0.0.1:$TGT n=1 m=0" \
        > "$CFG" 2> /dev/null; then
        _newfail=0
    else
        _newfail=1
    fi
    _has9=$(grep -c '^9 ' /proc/net/tbtun/tunnels 2> /dev/null)
    _out=$(timeout 60 /bin/adv_probe echo "$PUB" 1 0 2>&1)
    case $_out in
    ECHO_OK*) _oldok=1 ;;
    *) _oldok=0 ;;
    esac

    # (b) The replace path: the same id, a listen port held by a stranger.
    # The undo path destroys the old tunnel (review 3's leak fix), so record
    # whether it survived; either a live tunnel or a clean removal is
    # acceptable, a row that exists but does not serve is not.
    if echo "tunnel 1 role=far profile=raw listen=127.0.0.1:19199 target=127.0.0.1:$TGT n=1 m=0" \
        > "$CFG" 2> /dev/null; then
        _repfail=0
    else
        _repfail=1
    fi
    _has1=$(grep -c '^1 ' /proc/net/tbtun/tunnels 2> /dev/null)
    _out=$(timeout 30 /bin/adv_probe echo "$PUB" 1 0 2>&1)
    case $_out in
    ECHO_OK*) _repok=1 ;;
    *) _repok=0 ;;
    esac

    kill "$HOLD" 2> /dev/null
    wait "$HOLD" 2> /dev/null
    sleep 1
    if echo "tunnel 1 role=far profile=raw listen=127.0.0.1:$CAR target=127.0.0.1:$TGT n=1 m=0" \
        > "$CFG" 2> /dev/null; then
        _retry=1
    else
        _retry=0
    fi
    sleep 1
    _out=$(timeout 60 /bin/adv_probe echo "$PUB" 1 0 2>&1)
    case $_out in
    ECHO_OK*) _retryok=1 ;;
    *) _retryok=0 ;;
    esac

    _klog=$(dmesg 2> /dev/null |
        grep -cE 'WARNING:|BUG:|Oops|general protection fault|Call Trace:|refcount_t:|KASAN|UBSAN')
    if [ "$_newfail" -eq 1 ] && [ "$_has9" -eq 0 ] && [ "$_oldok" -eq 1 ] &&
        [ "$_retry" -eq 1 ] && [ "$_retryok" -eq 1 ] && [ "${_klog:-0}" -eq 0 ]; then
        res create.failure PASS "held port: new-id create refused, no tunnel 9, tunnels 1/2 still echo, retry after release works (replace refused=$_repfail old_present=$_has1 old_usable=$_repok)"
    else
        res create.failure FAIL "new-id refused=$_newfail tunnel9=$_has9 old_echo=$_oldok retry_write=$_retry retry_echo=$_retryok klog=$_klog"
    fi
    if [ "$_repfail" -eq 1 ] &&
        { { [ "$_has1" -eq 1 ] && [ "$_repok" -eq 1 ]; } ||
        { [ "$_has1" -eq 0 ] && [ "$_repok" -eq 0 ]; }; }; then
        res create.replace PASS "replace with a held port refused; old tunnel survived=$_has1 usable=$_repok (destroy-on-failure is the current contract; no row is left half-configured)"
    else
        res create.replace FAIL "replace refused=$_repfail old_present=$_has1 old_usable=$_repok: a refused replace must either keep the old tunnel serving or remove it cleanly"
    fi
    flush_all
}

