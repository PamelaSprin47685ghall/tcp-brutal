}

phase_stall() {
    echo "== carrier accept/read chain and flush stack"
    flush_all
    # The ACCEPTED logs are KERN_INFO; raise the console for this phase so the
    # per-connection STALL lines (printk, atomic) and the module's accept logs
    # are both in the console evidence.
    echo 7 > /proc/sys/kernel/printk 2> /dev/null
    echo 1 > /proc/sys/kernel/sysrq 2> /dev/null
    echo "tunnel 1 role=far profile=http-kal listen=127.0.0.1:$CAR target=127.0.0.1:$TGT n=4 m=0" \
        > "$CFG" || res init.stall_setup FAIL "far tunnel rejected"
    sleep 1
    timeout 60 /bin/adv_probe stall "$CAR" 15 1 > /tmp/stall.out 2>&1
    RC=$?
    echo 3 > /proc/sys/kernel/printk 2> /dev/null
    cat /tmp/stall.out
    case $RC in
    124 | 143) res stall.probe TIMEOUT "adv_probe stall did not finish in 60s" ;;
    esac
    echo "STALL_STATS_BEGIN"
    cat /proc/net/tbtun/stats 2> /dev/null
    cat /proc/net/tbtun/tunnels 2> /dev/null
    echo "STALL_STATS_END"

    # The flush is in a subshell: the phase must survive long enough to dump
    # the blocked-task stacks if the write never returns.
    echo "STALL_FLUSH_BEGIN"
    rm -f /tmp/flush.done
    ( echo flush > "$CFG"; echo done > /tmp/flush.done ) &
    sleep 5
    if [ -e /tmp/flush.done ]; then
        res stall.flush PASS "flush completed after the carrier chain"
    else
        res stall.flush FAIL "flush hung after the carrier chain; sysrq w/t follows"
        echo w > /proc/sysrq-trigger 2> /dev/null
        sleep 1
        echo t > /proc/sysrq-trigger 2> /dev/null
        sleep 2
        dmesg | tail -200
    fi
    # No second flush: the group is here for the evidence, and the guest may
    # be wedged by the first one.
}

# Close-drain: the application writes 16 MiB and closes while the tunnel still
# holds a queue; the target reads until EOF and must count every byte.  The
# sink reads slowly so the queue is still non-empty at close, and a short
# control stream on the same carrier must complete as well.  The near's FIN is
# checked against the final offset in /proc: a FIN that named less would let
# the far report EOF before the last byte.
phase_closedrain() {
    echo "== close drain"
    /bin/adv_probe sink "$SINK" 5 > /tmp/sink.out 2>&1 &
    _sp=$!
    sleep 1
    flush_all
    echo "tunnel 1 role=far profile=raw listen=127.0.0.1:$CAR target=127.0.0.1:$SINK n=1 m=0" \
        > "$CFG" || res pub.closedrain FAIL "far tunnel rejected"
    echo "tunnel 2 role=near profile=raw listen=127.0.0.1:$CDPUB peer=127.0.0.1:$CAR n=1 m=0" \
        > "$CFG" || res pub.closedrain FAIL "near tunnel rejected"
    sleep 1
    _ctl=$(timeout 30 /bin/adv_probe ctlping "$CDPUB" ping 2>&1)
    _bulk=$(timeout 180 /bin/adv_probe sendclose "$CDPUB" 16 2 2>&1)
    # The sink parent accepts forever; wait for both child verdicts, not for
    # the parent to exit, and read the stream evidence before the 2 s
    # tombstone reaps it.
    _i=0
    while [ "$_i" -lt 60 ]; do
        grep -q '^SINK_BULK' /tmp/sink.out 2> /dev/null &&
            grep -q '^SINK_CTRL' /tmp/sink.out 2> /dev/null && break
        sleep 1
        _i=$((_i + 1))
    done
    kill "$_sp" 2> /dev/null
    wait "$_sp" 2> /dev/null
    _sink=$(cat /tmp/sink.out)
    cat /proc/net/tbtun/stats > /tmp/closedrain.stats 2>/dev/null
    _stats=$(cat /tmp/closedrain.stats)
    _finseqs=$(grep -o 'fin_seq=[0-9]*' /tmp/closedrain.stats 2> /dev/null |
        sort -u | tr '\n' ',')
    case "$_stats" in
    *"fin_seq=16777216"*) _fin=1 ;;
    *) _fin=0 ;;
    esac
    case "$_bulk" in
    *"SENDCLOSE_OK"*) _b=1 ;;
    *) _b=0 ;;
    esac
    case "$_ctl" in
    *"CTLPING_OK"*) _c=1 ;;
    *) _c=0 ;;
    esac
    case "$_sink" in
    *"SINK_BULK bytes=16777216 eof=1"*) _sb=1 ;;
    *) _sb=0 ;;
    esac
    case "$_sink" in
    *"SINK_CTRL echoed=4"*) _sc=1 ;;
    *) _sc=0 ;;
    esac
    _drain=$((_b & _c & _sb & _sc))
    case "$_bulk" in
    *"txq_after=0"*) _queued=0 ;;
    *) _queued=1 ;;
    esac
    if [ "$_drain" -eq 1 ] && [ "$_fin" -eq 1 ] && [ "$_queued" -eq 1 ]; then
        res pub.closedrain PASS "$_sink; $_bulk; $_ctl; fin_seq=$_finseqs"
    else
        res pub.closedrain FAIL "$_sink; $_bulk; $_ctl; fin_seq_match=$_fin fin_seq=$_finseqs"
        grep 'stream sid=' /tmp/closedrain.stats 2> /dev/null
    fi
}

# Bounded close: the target accepts and then stops reading, so the far can
# never deliver the tail and tx_ack never covers the FIN's offset.  The close
# must end in a reset after the budget, not pin the stream and its socket
# forever.  hole_budget_ms=1000 makes the budget deterministic.
phase_closedrain_timeout() {
    echo "== close drain timeout"
    /bin/adv_probe sink "$SINK" 30000 > /tmp/sink_stall.out 2>&1 &
    _sp=$!
    sleep 1
    flush_all
    echo "tunnel 1 role=far profile=raw listen=127.0.0.1:$CAR target=127.0.0.1:$SINK n=1 m=0 rx_reorder_bytes=8388608 hole_budget_ms=1000" \
        > "$CFG" || res pub.closedrain_timeout FAIL "far tunnel rejected"
    echo "tunnel 2 role=near profile=raw listen=127.0.0.1:$CDPUB peer=127.0.0.1:$CAR n=1 m=0 tx_window_bytes=8388608 hole_budget_ms=1000" \
        > "$CFG" || res pub.closedrain_timeout FAIL "near tunnel rejected"
    sleep 1
    _out=$(timeout 60 /bin/adv_probe sendclose "$CDPUB" 4 2 2>&1)
    # The reset is due one budget after the FIN arrives and delivery stops;
    # the FIN itself travels behind the data, so poll instead of guessing.
    _i=0
    while [ "$_i" -lt 40 ]; do
        cat /proc/net/tbtun/stats > /tmp/closedrain_timeout.stats 2> /dev/null
        grep -q 'deliver_timeouts=[1-9]' /tmp/closedrain_timeout.stats && break
        sleep 1
        _i=$((_i + 1))
    done
    _ct=$(grep -o 'close_timeouts=[0-9]*' /tmp/closedrain_timeout.stats 2> /dev/null | head -1)
    _dt=$(grep -o 'deliver_timeouts=[0-9]*' /tmp/closedrain_timeout.stats 2> /dev/null | sort -u | tr '\n' ',')
    # The stats file has one `tunnel <id> streams ...` line per tunnel.  The
    # near tunnel is id 2; taking the first streams_active= would read the
    # far tunnel (id 1) and never prove the near released its stream.
    _act=$(awk '$1 == "tunnel" && $2 == 2 && $3 == "streams" {
        for (i = 1; i <= NF; i++)
            if ($i ~ /^streams_active=/) { print $i; exit }
    }' /tmp/closedrain_timeout.stats 2> /dev/null)
    [ -n "$_act" ] || _act="streams_active=<no tunnel 2 streams line>"
    kill "$_sp" 2> /dev/null
    wait "$_sp" 2> /dev/null
    case "$_out" in
    *"SENDCLOSE_OK"*) _ok=1 ;;
    *) _ok=0 ;;
    esac
    if echo "$_dt" | grep -q 'deliver_timeouts=[1-9]'; then
        _d=1
    else
        _d=0
    fi
    if [ "$_ok" -eq 1 ] && [ "$_d" -eq 1 ] &&
        [ "$_act" = "streams_active=0" ]; then
        res pub.closedrain_timeout PASS "$_out; $_dt; $_ct; $_act"
    else
        res pub.closedrain_timeout FAIL "$_out; $_dt; $_ct; $_act"
        cat /tmp/closedrain_timeout.stats 2> /dev/null
    fi
}

for _p in public srcfilter control resource slab final replay rmmod flush catconfig bigcfg cfg_mix param port near nearx far farx stall writer writerdrain halfclose httptorn hole create closedrain closedrain_timeout; do
    want "$_p" || continue
    echo "PHASE_START $_p"
    "phase_$_p"
    echo "PHASE_END $_p"
done

echo "TBT_ADV_DONE"
sync
poweroff -f
exec /bin/busybox poweroff -f
