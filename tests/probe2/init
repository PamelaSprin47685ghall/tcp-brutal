#!/bin/sh
# init - PID 1 for the injection probe (tests/probe2). Not the tbtun test.
set -u

fail() {
    echo "TBT_TEST_FAIL $*"
    sync
    poweroff -f
    exec /bin/busybox poweroff -f
}

echo "== tbt_probe2 guest: $(uname -r)"
export PATH=/bin

mkdir -p /proc /sys /dev /tmp
mount -t proc proc /proc || fail "mount /proc"
mount -t sysfs sysfs /sys || fail "mount /sys"
mount -t devtmpfs devtmpfs /dev 2> /dev/null || mount -t ramfs ramfs /dev
mount -t tmpfs tmpfs /tmp || fail "mount /tmp"
grep -q ' /proc ' /proc/mounts || fail "/proc is not a mounted procfs"

ip link set lo up || fail "ip link set lo up"

echo "== loading tbt_probe2.ko (arm_repair=$(cat /arm_repair 2> /dev/null || echo 0))"
insmod /tbt_probe2.ko arm_repair=$(cat /arm_repair 2> /dev/null || echo 0) || fail "insmod /tbt_probe2.ko (see the kernel log above)"
grep -q '^tbt_probe2 ' /proc/modules || fail "tbt_probe2 not in /proc/modules"
[ -e /dev/tbtprobe2 ] || fail "/dev/tbtprobe2 missing after load"
echo "== tbt_probe2 loaded"

echo "== running /probe2_user"
/probe2_user
rc=$?
echo "== probe2_user exited $rc"

dmesg | grep -E 'tbt_probe2:|WARN|BUG|TCP recvmsg seq' | tail -n 12

if [ $rc -ne 0 ]; then
    fail "probe2_user reported a failed assertion (rc=$rc)"
fi
echo "TBT_TEST_PASS"
sync
poweroff -f
