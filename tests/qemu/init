    rmmod tbtun || fail "rmmod tbtun"
    insmod /tbtun.ko debug=2 debug_loss=1 || fail "insmod /tbtun.ko debug_loss=1"
    [ -e "$CFG" ] || fail "$CFG missing after reload with debug_loss=1"
    grep -q '^debug_loss=1' /proc/net/tbtun/stats || fail "stats does not report debug_loss=1"
fi

want B && run_probe B
want C && run_probe C
