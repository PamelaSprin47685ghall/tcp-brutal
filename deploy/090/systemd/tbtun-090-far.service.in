# deploy/090/systemd/tbtun-090-far.service.in
# Rendered by deploy/090/Makefile for tbtun @TBTUN_COMMIT@.
# Far side. The unit loads the module and applies the tunnel line once; the
# module keeps its state after the unit reaches active (RemainAfterExit=yes).
# Wants= keeps the start order without coupling lifetimes: the tunnel needs a
# live VLESS listener first (After=), but stopping or restarting mihomo must
# not stop the tunnel.
[Unit]
Description=tbtun 0.9.0 kernel tunnel (far side)
After=mihomo-090-far.service
Wants=mihomo-090-far.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/sbin/modprobe tbtun
ExecStart=/bin/sh -c 'cat /etc/tbtun-090.conf > /proc/net/tbtun/config'
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
