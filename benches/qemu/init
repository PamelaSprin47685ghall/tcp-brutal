#!/bin/sh
# benches/qemu/init - PID 1 of the benchmark guest.
#
# One boot runs one scenario named in /bench.txt and prints machine-readable
# rows that benches/run.sh turns into a CSV:
#
#   BENCHROW  row=<name> k=v ...        one measurement
#   BENCHCAR  row=<name> carrier=...    one carrier of that measurement
#   BENCHNOTE <text>                    progress or a diagnostic
#   BENCHMETA k=v ...                   environment of this boot
#   BENCH_DONE <scenario>               the scenario finished
#
# Everything is driven through the module's operator surface (`echo` into
# /proc/net/tbtun/*), the same way tests/qemu/init drives probes. The shaped
# path is the probe-I technique: one htb class of 10 Mbit per source port, a
# u32 filter per port, and netem on each class, all inside the guest.
#
# The transfer is host/tbt_burst.c's strict send-then-read phase: 40 MiB are
# sent with blocking send() and then read back and compared, so a completed
# row is also a byte-exactness result. Rates are sampled over a 2 s window
# while the transfer runs, from the counters at the same layer probe I uses.
set -u
export PATH=/bin

CFG=/proc/net/tbtun/config
PORTS=/proc/net/tbtun/ports
PEERS=/proc/net/tbtun/peers
TUNNELS=/proc/net/tbtun/tunnels
PUB_PORT=${TBT_BENCH_PUB_PORT:-19100}
CAR_PORT=${TBT_BENCH_CAR_PORT:-19101}
ECHO_PORT=${TBT_BENCH_ECHO_PORT:-19102}
SINK_PORT=${TBT_BENCH_SINK_PORT:-19103}
GUEST_IP=10.0.2.15
GATEWAY=10.0.2.2
# The module's carrier port block: 16 ports is max_carriers, so n=16 uses it
# exactly. The qdisc has 32 classes; the extra 16 ports (41016..41031) are
# control/latency flows that must be shaped like a carrier but must never be
# picked by the module.
PORTBLOCK_LO=41000
PORTBLOCK_MOD=16
CLASS_PORTS=32
CTRL_SPORT_BASE=41024
CAR_HOSTPORT=29101
ECHO_HOSTPORT=29102
SINK_HOSTPORT=29103

# Scenario parameters, filled from /bench.txt.
P_scenario=
P_nlist=1,2,4,8
P_mib=40
P_profile=raw
P_dup=0
P_loss=0,10000,50000,100000
P_iters=10000
P_loss_iters=2000
P_bytes=1024
P_netem='delay|20ms|10ms'
P_rx_reorder=2097152
P_hole_budget=5000
P_window=2
P_profiles=raw,http-kal,http-kal-drip
P_control=1
P_control_mbit=0
P_hole_iters=2000
P_wan_mbit=17
P_wan_delay=109
P_tx_window=0

# Globals a measurement leaves for its row.
X_N=0 X_M=0 X_PROFILE=none X_MIB=0 X_RC=99 X_STRICT=0
X_MBIT=0 X_APP_MBIT=0 X_WALL=0 X_WIRE=0 X_APP=0 X_WPA=0
X_FRAMES=0 X_WPS=0 X_CSYS=0 X_CSOFT=0 X_CTOT=0 X_KW=0
X_RETX=0 X_DUP=0 X_INFL=0 X_HD=0 X_HR=0 X_HU=0
X_STALL=0 X_DEPTH=0 X_TXQ=0 X_RXQ=0 X_OOO=0 X_RET=0
X_UP=0 X_NTOT=0
C_T0=0 C_BUSY0=0 C_SYS0=0 C_SOFT0=0 KW0=0 T_START=0
ctrl_seq=0
sampler_pid=
memsampler_pid=
echo_pid=

bench_note()
{
    printf 'BENCHNOTE %s\n' "$*"
}

bench_row()
{
    _row=$1
    shift
    printf 'BENCHROW row=%s' "$_row"
    for _kv in "$@"; do
        printf ' %s' "$_kv"
    done
    printf '\n'
}

fatal()
{
    printf 'BENCH_FATAL %s\n' "$*"
    sync
    poweroff -f
    exec /bin/busybox poweroff -f
}

# --- operator-surface helpers ----------------------------------------------
tunnel_stat()
{
    awk -v id="$1" -v key="$2" '
        $1 == "tunnel" && $2 == id {
            for (i = 1; i <= NF; i++)
                if (index($i, key "=") == 1) { split($i, a, "="); print a[2] }
        }' /proc/net/tbtun/stats
}
stat_sum()
{
    awk -v key="$1" '
        $1 == "tunnel" {
            for (i = 1; i <= NF; i++)
                if (index($i, key "=") == 1) { split($i, a, "="); s += a[2] }
        }
        END { print s + 0 }' /proc/net/tbtun/stats
}
stat_max()
{
    awk -v key="$1" '
        $1 == "tunnel" {
            for (i = 1; i <= NF; i++)
                if (index($i, key "=") == 1) { split($i, a, "="); if (a[2] + 0 > m) m = a[2] + 0 }
        }
        END { print m + 0 }' /proc/net/tbtun/stats
}
# peers columns: the module prints its order in the header line, and a release
# may insert a column (the WAN work adds delivery_rate_bps, cwnd_bytes and
# snd_wnd after inflight). Resolve the indices once from that header so a
# column shift cannot silently turn tx_bytes into something else.
PC_TUNNEL=1 PC_CARRIER=2 PC_SPORT=3 PC_UACK=5 PC_RTT=6 PC_INFLIGHT=7
PC_STATE=8 PC_PROFILE=9 PC_FRAMES=13 PC_BYTES=14 PC_DROPPED=15 PC_RETX=16
PC_RATE=0 PC_CWND=0 PC_SNDWND=0
peer_cols_init()
{
    # The header's first token is "#", which is not a column: the names start
    # at the second token but describe data field 1.
    _i=0
    for _f in $(awk '/^#/ { print; exit }' "$PEERS"); do
        case $_f in
        id) PC_TUNNEL=$_i ;;
        tunnel) PC_TUNNEL=$_i ;;
        carrier) PC_CARRIER=$_i ;;
        sport) PC_SPORT=$_i ;;
        uack) PC_UACK=$_i ;;
        rtt_us) PC_RTT=$_i ;;
        inflight) PC_INFLIGHT=$_i ;;
        delivery_rate_bps) PC_RATE=$_i ;;
        cwnd_bytes) PC_CWND=$_i ;;
        snd_wnd) PC_SNDWND=$_i ;;
        state) PC_STATE=$_i ;;
        class) PC_PROFILE=$_i ;;
        tx_frames) PC_FRAMES=$_i ;;
        tx_bytes) PC_BYTES=$_i ;;
        dropped) PC_DROPPED=$_i ;;
        retx_ppm) PC_RETX=$_i ;;
        esac
        _i=$((_i + 1))
    done
}
peer_sum()
{
    awk -v id="$1" -v n="$2" '$1 == id { s += $n } END { print s + 0 }' "$PEERS"
}
peers_up()
{
    awk -v id="$1" -v c="$PC_STATE" '$1 == id && $c == "up" { n++ } END { print n + 0 }' \
        "$PEERS"
}
peers_total()
{
    awk -v id="$1" '$1 == id { n++ } END { print n + 0 }' "$PEERS"
}
peer_retx_max()
{
    awk -v id="$1" -v c="$PC_RETX" '$1 == id { if ($c + 0 > m) m = $c + 0 } END { print m + 0 }' \
        "$PEERS"
}
peer_rtt_max()
{
    awk -v id="$1" -v c="$PC_RTT" '$1 == id && $c + 0 > m { m = $c + 0 } END { print m + 0 }' \
        "$PEERS"
}
peer_rtt_min()
{
    awk -v id="$1" -v c="$PC_RTT" '
        $1 == id && $c + 0 > 0 && (m == 0 || $c + 0 < m) { m = $c + 0 }
        END { print m + 0 }' "$PEERS"
}

flush_and_wait()
{
    echo 'flush' > "$CFG" 2> /dev/null || true
    sleep 1
}

configure()
{
    _n=$1 _m=$2 _p=$3 _d=$4 _x=${5:-}
    echo "ports $PORTBLOCK_LO-$((PORTBLOCK_LO + PORTBLOCK_MOD - 1))" > "$PORTS" || return 1
    # The far listener must bind the eth0 address: qemu's hostfwd delivers the
    # carrier connection there, not to loopback.
    echo "tunnel 1 role=far profile=$_p listen=$GUEST_IP:$CAR_PORT target=127.0.0.1:$ECHO_PORT n=$_n m=$_m dup=$_d rx_reorder_bytes=$P_rx_reorder hole_budget_ms=$P_hole_budget $_x" \
        > "$CFG" || return 1
    echo "tunnel 2 role=near profile=$_p listen=127.0.0.1:$PUB_PORT peer=$GATEWAY:$CAR_HOSTPORT n=$_n m=$_m dup=$_d rx_reorder_bytes=$P_rx_reorder hole_budget_ms=$P_hole_budget $_x" \
        > "$CFG" || return 1
    # The exact operator-surface state that produced the next row, for the
    # CSV: canonical config plus the port block, spaces as '|' and lines as
    # ';' so the whole thing is one CSV field.
    printf 'BENCHCFG %s;%s\n' "$(grep '^ports ' "$PORTS" | head -n 1)" \
        "$(tr '\n' ';' < "$CFG")" | tr ' ' '|' | tr '\n' ' '
    return 0
}

# --- CPU accounting ---------------------------------------------------------
# /proc/stat fields after "cpu": user nice system idle iowait irq softirq
# steal ...; system+irq+softirq is the kernel cost of the transfer, and the
# tick rate is 100 Hz, so delta_ticks / wall_seconds is percent of one vCPU.
cpu_now()
{
    awk '/^cpu / { busy = $4 + $7 + $8; sys = $4; soft = $8; tot = 0;
                   for (i = 2; i <= 9; i++) tot += $i;
                   printf "%d %d %d %d\n", tot, busy, sys, soft; seen = 1 }
              END { if (!seen) print "0 0 0 0" }' /proc/stat
}
kworker_ticks()
{
    awk '
        {
            c = substr($0, index($0, "(") + 1)
            c = substr(c, 1, index(c, ")") - 1)
            if (c !~ /^kworker/) next
            rest = substr($0, index($0, ")") + 2)
            split(rest, a, " ")
            s += a[12] + a[13]
        }
        END { print s + 0 }' /proc/[0-9]*/stat
}
cpu_begin()
{
    C_T0=$(up_now)
    set -- $(cpu_now)
    C_BUSY0=${2:-0} C_SYS0=${3:-0} C_SOFT0=${4:-0}
    KW0=$(kworker_ticks 2> /dev/null)
    case $KW0 in '' | *[!0-9]*) KW0=0 ;; esac
}
cpu_end()
{
    set -- $(cpu_now)
    _busy=${2:-0} _sys=${3:-0} _soft=${4:-0}
    _kw=$(kworker_ticks 2> /dev/null)
    case $_kw in '' | *[!0-9]*) _kw=0 ;; esac
    # The caller sets T_WALL (transfer wall time) before this runs; ticks are
    # 100/s, so delta_ticks / wall_s is percent of one vCPU.
    X_CSYS=$(awk -v d="$((_sys - C_SYS0))" -v w="$T_WALL" 'BEGIN { if (w > 0) printf "%.1f", d / w; else print 0 }')
    X_CSOFT=$(awk -v d="$((_soft - C_SOFT0))" -v w="$T_WALL" 'BEGIN { if (w > 0) printf "%.1f", d / w; else print 0 }')
    X_CTOT=$(awk -v d="$((_busy - C_BUSY0))" -v w="$T_WALL" 'BEGIN { if (w > 0) printf "%.1f", d / w; else print 0 }')
    X_KW=$(awk -v d="$((_kw - KW0))" -v w="$T_WALL" 'BEGIN { if (w > 0) printf "%.1f", d / w; else print 0 }')
}

up_now()
{
    read -r _up _rest < /proc/uptime
    echo "$_up"
}

# --- queue-depth sampler ----------------------------------------------------
# One awk and one sleep per 250 ms. It reads only the two /proc files, so its
# own cost stays below a percent of one vCPU; every scenario records the
# maximum it saw, not the last value.
q_sample()
{
    awk -v p_inf="$PC_INFLIGHT" -v p_rate="$PC_RATE" \
        -v p_cwnd="$PC_CWND" -v p_wnd="$PC_SNDWND" '
        FILENAME ~ /peers/ {
            if ($1 == "#") next
            if (p_inf && $p_inf + 0 > infl) infl = $p_inf + 0
            # Tunnel 2 is the near side: its carriers carry the application
            # bytes, so the in-flight and window evidence comes from here.
            if ($1 == 2) {
                if (p_inf) isum += $p_inf + 0
                if (p_rate) drate += $p_rate + 0
                if (p_cwnd) cwnd += $p_cwnd + 0
                if (p_wnd) sndw += $p_wnd + 0
            }
            next
        }
        /^tunnel / {
            for (i = 1; i <= NF; i++) {
                if (index($i, "=") == 0) continue
                split($i, a, "="); k = a[1]; v = a[2] + 0
                if (k == "txq" && v > txq) txq = v
                else if (k == "rxq" && v > rxq) rxq = v
                else if (k == "ooo_bytes" && v > ooo) ooo = v
                else if (k == "retain_bytes" && v > ret) ret = v
                else if (k == "pub_wmem" && v > pw) pw = v
                else if (k == "car_wmem" && v > cw) cw = v
                else if (k == "tx_window" && $2 == 2 && v > win) win = v
            }
        }
        END {
            if (win > 0 && isum > win) over = isum - win
            printf "%d %d %d %d %d %d %d %d %d %d %d %d %d\n",
                      infl, txq, rxq, ooo, ret, pw, cw, isum, win,
                      drate, cwnd, sndw, over
        }
    ' "$PEERS" /proc/net/tbtun/stats
}
sampler_start()
{
    rm -f /tmp/q.log /tmp/qstop
    (
        while [ ! -e /tmp/qstop ]; do
            printf '%s ' "$(up_now)" >> /tmp/q.log
            q_sample >> /tmp/q.log
            sleep 0.25
        done
    ) &
    sampler_pid=$!
}
sampler_stop()
{
    [ -n "${sampler_pid:-}" ] || return 0
    : > /tmp/qstop
    wait "$sampler_pid" 2> /dev/null
    sampler_pid=
}
q_max()
{
    awk -v f="$1" '{ if ($f + 0 > m) m = $f + 0 } END { print m + 0 }' /tmp/q.log 2> /dev/null || echo 0
}

# --- memory sampler ---------------------------------------------------------
mem_used()
{
    awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { print t - a }' /proc/meminfo
}
proc_rss()
{
    awk '{ s += $2 } END { print s * 4 }' /proc/[0-9]*/statm 2> /dev/null
}
slab_used()
{
    awk '/^Slab:/ { print $2 }' /proc/meminfo
}
mem_sample()
{
    printf '%s %s %s %s\n' "$(up_now)" "$(mem_used)" "$(proc_rss)" "$(slab_used)"
}
memsampler_start()
{
    rm -f /tmp/m.log /tmp/mstop
    (
        while [ ! -e /tmp/mstop ]; do
            mem_sample >> /tmp/m.log
            sleep 1
        done
    ) &
    memsampler_pid=$!
}
memsampler_stop()
{
    [ -n "${memsampler_pid:-}" ] || return 0
    : > /tmp/mstop
    wait "$memsampler_pid" 2> /dev/null
    memsampler_pid=
}
m_max()
{
    awk -v f="$1" '{ if ($f + 0 > m) m = $f + 0 } END { print m + 0 }' /tmp/m.log 2> /dev/null || echo 0
}

# --- tc: 10 Mbit per source port, netem on each class -----------------------
tc_clear()
{
    /bin/tc qdisc del dev eth0 root 2> /dev/null
}
tc_setup()
{
    tc_clear
    /bin/tc qdisc add dev eth0 root handle 1: htb default 99 || return 1
    /bin/tc class add dev eth0 parent 1: classid 1:1 htb rate 1000mbit ceil 1000mbit || return 1
    /bin/tc class add dev eth0 parent 1:1 classid 1:99 htb rate 1000mbit ceil 1000mbit || return 1
    i=0
    while [ $i -lt $CLASS_PORTS ]; do
        port=$((PORTBLOCK_LO + i))
        cls=$((10 + i))
        /bin/tc class add dev eth0 parent 1:1 classid "1:$cls" htb rate 10mbit ceil 10mbit || return 1
        if [ -n "$NETEM_ARGS" ]; then
            /bin/tc qdisc add dev eth0 parent "1:$cls" handle "$((100 + i)):" netem $NETEM_ARGS || return 1
        fi
        /bin/tc filter add dev eth0 parent 1: protocol ip prio 1 u32 \
            match ip sport "$port" 0xffff flowid "1:$cls" || return 1
        i=$((i + 1))
    done
}

# --- tc: the WAN path, one boot ---------------------------------------------
# The measured path was 218 ms RTT at 17 Mbit/s. The delay is split over the
# two directions because both leave through eth0: the carrier's DATA matches
# its port class and pays one delay, and the far side's ACKs match no filter,
# so they take the default class and pay the other. htb on the port class is
# the carrier rate; the default class only delays. The u32 filters are the
# same per-port filters tc_setup() installs.
#
# burst 32k: htb's default 1500-byte bucket drains in 0.7 ms at 17 Mbit, so a
# 1 ms tick would cap the class near 12 Mbit. limit 10000: the default class
# carries the echo direction at 1 Gbit, where netem's 1000-packet queue would
# drop a burst above ~1.4 MB instead of delaying it.
tc_setup_wan()
{
    _mb=${P_wan_mbit:-17}
    _d=${P_wan_delay:-109}
    tc_clear
    /bin/tc qdisc add dev eth0 root handle 1: htb default 99 || return 1
    /bin/tc class add dev eth0 parent 1: classid 1:1 htb rate 1000mbit ceil 1000mbit || return 1
    /bin/tc class add dev eth0 parent 1:1 classid 1:99 htb rate 1000mbit ceil 1000mbit || return 1
    /bin/tc qdisc add dev eth0 parent 1:99 handle 99: netem delay "${_d}ms" limit 10000 || return 1
    i=0
    while [ $i -lt $CLASS_PORTS ]; do
        port=$((PORTBLOCK_LO + i))
        cls=$((10 + i))
        /bin/tc class add dev eth0 parent 1:1 classid "1:$cls" htb rate "${_mb}mbit" \
            ceil "${_mb}mbit" burst 32k cburst 32k || return 1
        /bin/tc qdisc add dev eth0 parent "1:$cls" handle "$((100 + i)):" \
            netem delay "${_d}ms" limit 10000 || return 1
        /bin/tc filter add dev eth0 parent 1: protocol ip prio 1 u32 \
            match ip sport "$port" 0xffff flowid "1:$cls" || return 1
        i=$((i + 1))
    done
}
tc_class_bytes()
{
    # iproute2 prints the byte counter on the line after the class header:
    #   class htb 1:34 root leaf 34: prio 0 rate 10Mbit ...
    #    Sent 1234 bytes 5 pkt (dropped 0, overlimits 0 requeues 0)
    /bin/tc -s class show dev eth0 2> /dev/null | awk -v c="1:$1" '
        $1 == "class" && $2 == "htb" && $3 == c { found = 1; next }
        found && $1 == "class" { exit }
        found && $1 == "Sent" { print $2; exit }'
}

# --- one tunnel transfer ----------------------------------------------------
# xfer N M PROFILE DUP MIB ROW [extra config] [drop_ppm]
# Fills the X_* globals. It does not print a row: the scenario decides which
# fields it wants and calls emit_xfer_row. drop_ppm arms the deterministic
# injector on carriers 1 and 2 after the tunnel exists and before the burst;
# it is a runtime action, so it cannot be part of the tunnel line.
xfer()
{
    X_N=$1 X_M=$2 X_PROFILE=$3 X_DUP=$4 X_MIB=$5
    _row=$6
    _extra=${7:-}
    _ppm=${8:-0}
    X_RC=99 X_STRICT=0 X_MBIT=0 X_APP_MBIT=0 X_WALL=0
    X_WIRE=0 X_APP=0 X_WPA=0 X_FRAMES=0 X_WPS=0
    X_RETX=0 X_DUP=0 X_INFL=0 X_HD=0 X_HR=0 X_HU=0 X_STALL=0 X_DEPTH=0
    X_TXQ=0 X_RXQ=0 X_OOO=0 X_RET=0 X_UP=0 X_NTOT=0
    X_RX_MBIT=0 X_INFL_SUM=0 X_WIN=0 X_DELIV=0 X_CWND=0 X_SNDW=0
    X_OVER=0

    flush_and_wait
    if ! configure "$X_N" "$X_M" "$X_PROFILE" "$X_DUP" "$_extra"; then
        bench_note "row=$_row: config rejected"
        return 1
    fi
    _i=0
    while [ $_i -lt 100 ]; do
        _u=$(peers_up 2)
        [ "${_u:-0}" -ge "${X_N:-0}" ] && break
        sleep 0.05
        _i=$((_i + 1))
    done
    if [ "$_ppm" -gt 0 ]; then
        echo "carrier 1 drop_ppm $_ppm" > "$PEERS" ||
            bench_note "row=$_row: carrier 1 drop_ppm rejected"
        echo "carrier 2 drop_ppm $_ppm" > "$PEERS" ||
            bench_note "row=$_row: carrier 2 drop_ppm rejected"
        bench_note "row=$_row: armed drop_ppm=$_ppm on carriers 1 and 2"
    fi
    X_UP=$(peers_up 2)
    X_NTOT=$(peers_total 2)
    bench_note "row=$_row: n=$X_N m=$X_M profile=$X_PROFILE carriers_up=$X_UP/$X_NTOT"

    # Whole-transfer baselines, taken before the burst.
    _wb=$(peer_sum 2 "$PC_BYTES")
    _ab=$(tunnel_stat 2 submit_bytes)
    _fb=$(peer_sum 2 "$PC_FRAMES")
    : "${_ab:=0}"

    sampler_start
    T_START=$(up_now)
    cpu_begin
    /bin/tbt_burst 127.0.0.1 "$PUB_PORT" "$X_MIB" 120 > /tmp/burst.log 2>&1 &
    _bpid=$!

    # Start the rate window once the tunnel has actually captured data: a
    # window that begins during connection setup measures the handshake.
    _i=0
    while [ $_i -lt 6000 ]; do
        _s=$(tunnel_stat 2 submit_bytes)
        [ "${_s:-0}" -ge 262144 ] && break
        kill -0 "$_bpid" 2> /dev/null || break
        sleep 0.05
        _i=$((_i + 1))
    done
    if kill -0 "$_bpid" 2> /dev/null; then
        _t0=$(up_now)
        _w0=$(peer_sum 2 "$PC_BYTES")
        _a0=$(tunnel_stat 2 submit_bytes)
        _f0=$(peer_sum 2 "$PC_FRAMES")
        _x0=$(tunnel_stat 2 rx_delivered)
        sleep "$P_window"
        _t1=$(up_now)
        _w1=$(peer_sum 2 "$PC_BYTES")
        _a1=$(tunnel_stat 2 submit_bytes)
        _f1=$(peer_sum 2 "$PC_FRAMES")
        _x1=$(tunnel_stat 2 rx_delivered)
        X_MBIT=$(awk -v a="$_w0" -v b="$_w1" -v x="$_t0" -v y="$_t1" \
            'BEGIN { t = y - x; if (t <= 0) t = 1; printf "%.2f", (b - a) * 8 / 1000000 / t }')
        X_APP_MBIT=$(awk -v a="$_a0" -v b="$_a1" -v x="$_t0" -v y="$_t1" \
            'BEGIN { t = y - x; if (t <= 0) t = 1; printf "%.2f", (b - a) * 8 / 1000000 / t }')
        # The receiver side: bytes the near tunnel accepted on the burst's
        # public socket. It is the echo direction, so it is sampled over the
        # same window as the wire rate.
        X_RX_MBIT=$(awk -v a="${_x0:-0}" -v b="${_x1:-0}" -v x="$_t0" -v y="$_t1" \
            'BEGIN { t = y - x; if (t <= 0) t = 1; printf "%.2f", (b - a) * 8 / 1000000 / t }')
        X_WPS=$(awk -v a="$_f0" -v b="$_f1" -v x="$_t0" -v y="$_t1" \
            'BEGIN { t = y - x; if (t <= 0) t = 1; printf "%.1f", (b - a) / t }')
        _ad=$((_a1 - _a0))
        _wd=$((_w1 - _w0))
        X_WPA=$(awk -v w="$_wd" -v a="$_ad" 'BEGIN { if (a > 0) printf "%.4f", w / a; else print 0 }')
        if ! kill -0 "$_bpid" 2> /dev/null; then
            bench_note "row=$_row: transfer ended inside the rate window"
        fi
    else
        bench_note "row=$_row: transfer ended before the rate window"
    fi

    wait "$_bpid"
    X_RC=$?
    T_END=$(up_now)
    T_WALL=$(awk -v a="$T_START" -v b="$T_END" 'BEGIN { printf "%.3f", b - a }')
    cpu_end
    sampler_stop

    _w2=$(peer_sum 2 "$PC_BYTES")
    _a2=$(tunnel_stat 2 submit_bytes)
    _f2=$(peer_sum 2 "$PC_FRAMES")
    X_WIRE=$(( ${_w2:-0} - ${_wb:-0} ))
    X_APP=$(( ${_a2:-0} - ${_ab:-0} ))
    X_FRAMES=$(( ${_f2:-0} - ${_fb:-0} ))
    # X_WALL is the transfer's wall time, not the rate window's.
    X_WALL=$T_WALL
    grep -q 'strict phase passed' /tmp/burst.log && X_STRICT=1
    if [ "$X_RC" -ne 0 ]; then
        bench_note "row=$_row: tbt_burst rc=$X_RC"
        # The banner carries the errno and the phase; the stats dump follows.
        awk '{ print "BENCHSTATS burst " $0 }' /tmp/burst.log 2> /dev/null
    fi

    # Honest retransmit rate: DATA copies / unique DATA records, session-wide.
    # peer_retx_max is the old per-carrier ratio over every record (FBK
    # included); it stays available for the latency notes.
    X_RETX=$(tunnel_stat 2 retx_data_ppm)
    X_RH=$(tunnel_stat 2 retx_hole)
    X_RS=$(tunnel_stat 2 retx_slow)
    X_RP=$(tunnel_stat 2 retx_pathloss)
    X_RDP=$(tunnel_stat 2 dup_bytes_ppm)
    : "${X_RETX:=0}" "${X_RH:=0}" "${X_RS:=0}" "${X_RP:=0}" "${X_RDP:=0}"
    X_DUP=$(tunnel_stat 2 dup_tx)
    X_INFL=$(tunnel_stat 2 inflate_ppm)
    X_HD=$(tunnel_stat 2 holes_declared)
    X_HR=$(tunnel_stat 2 holes_repaired)
    X_HU=$(tunnel_stat 2 holes_unrecoverable)
    X_STALL=$(tunnel_stat 2 rx_max_stall_us)
    X_DEPTH=$(tunnel_stat 2 reorder_max_depth)
    : "${X_DUP:=0}" "${X_INFL:=0}" "${X_HD:=0}" "${X_HR:=0}" "${X_HU:=0}" "${X_STALL:=0}" "${X_DEPTH:=0}"

    X_TXQ=$(q_max 3)
    X_RXQ=$(q_max 4)
    X_OOO=$(q_max 5)
    X_RET=$(q_max 6)
    X_INFL_SUM=$(q_max 8)
    X_WIN=$(q_max 9)
    X_DELIV=$(q_max 10)
    X_CWND=$(q_max 11)
    X_SNDW=$(q_max 12)
    X_OVER=$(q_max 13)

    # Per-carrier evidence, near side (the shaped direction).
    # delivery_rate_bps, cwnd_bytes and snd_wnd exist only after the sender
    # window work; the other columns are addressed by name so the extra
    # columns cannot shift them. rtt_us is the carrier's own TCP RTT.
    awk -v row="$_row" -v p_car="$PC_CARRIER" -v p_sport="$PC_SPORT" \
        -v p_state="$PC_STATE" -v p_prof="$PC_PROFILE" -v p_bytes="$PC_BYTES" \
        -v p_frames="$PC_FRAMES" -v p_drop="$PC_DROPPED" -v p_retx="$PC_RETX" \
        -v p_inf="$PC_INFLIGHT" -v p_rate="$PC_RATE" -v p_cwnd="$PC_CWND" \
        -v p_wnd="$PC_SNDWND" -v p_rtt="$PC_RTT" '
        $1 == 2 {
            printf "BENCHCAR row=%s carrier=%s sport=%s state=%s profile=%s bytes=%s frames=%s dropped=%s retx_ppm=%s inflight=%s rtt_us=%s",
                   row, $p_car, $p_sport, $p_state, $p_prof, $p_bytes, $p_frames,
                   $p_drop, $p_retx, $p_inf, $p_rtt
            if (p_rate) printf " delivery_rate_bps=%s", $p_rate
            if (p_cwnd) printf " cwnd_bytes=%s", $p_cwnd
            if (p_wnd) printf " snd_wnd=%s", $p_wnd
            printf "\n"
        }' "$PEERS"
    return 0
}

emit_xfer_row()
{
    _row=$1
    shift
    bench_row "$_row" n="$X_N" m="$X_M" profile="$X_PROFILE" mib="$X_MIB" \
        goodput_mbit="$X_MBIT" app_mbit="$X_APP_MBIT" wall_s="$X_WALL" \
        wire_bytes="$X_WIRE" app_bytes="$X_APP" wire_per_app="$X_WPA" \
        frames="$X_FRAMES" frames_s="$X_WPS" \
        cpu_sys_pct="$X_CSYS" cpu_softirq_pct="$X_CSOFT" cpu_total_pct="$X_CTOT" \
        kworker_pct="$X_KW" retx_ppm="$X_RETX" dup_tx="$X_DUP" inflate_ppm="$X_INFL" \
        retx_hole="$X_RH" retx_slow="$X_RS" retx_pathloss="$X_RP" \
        dup_bytes_ppm="$X_RDP" \
        fb_delay_us="$(tunnel_stat 2 fb_delay_us)" rto_us="$(tunnel_stat 2 rto_us)" \
        fbk_tx="$(tunnel_stat 2 fbk_tx)" \
        holes_declared="$X_HD" holes_repaired="$X_HR" holes_unrecoverable="$X_HU" \
        rx_max_stall_us="$X_STALL" reorder_max_depth="$X_DEPTH" \
        carriers_up="$X_UP/$X_NTOT" txq_max="$X_TXQ" rxq_max="$X_RXQ" \
        ooo_bytes_max="$X_OOO" retain_bytes_max="$X_RET" \
        rc="$X_RC" strict="$X_STRICT" "$@"
}

# --- the control: dd | nc over one shaped 5-tuple ---------------------------
# The sender is busybox nc bound to a source port inside the shaped block, so
# the flow meets exactly one 10 Mbit htb class, like one carrier. Rates are
# read from that class's byte counter, which is the same place (above the
# wire) the tunnel's carrier bytes are counted. Completion is the class
# counter reaching MIB, not dd returning: close() does not wait for the
# socket buffer to drain.
control_measure()
{
    _mib=$1
    ctrl_seq=$((ctrl_seq + 1))
    _sport=$((CTRL_SPORT_BASE + ctrl_seq))
    _cls=$((10 + _sport - PORTBLOCK_LO))
    if ! tc_setup; then
        bench_note "control: tc setup failed"
        bench_row control n=0 m=0 profile=control mib="$_mib" rc=1
        return 1
    fi
    _b0=$(tc_class_bytes "$_cls")
    : "${_b0:=0}"
    T_START=$(up_now)
    cpu_begin
    (
        dd if=/dev/zero bs=65536 count=$((_mib * 16)) 2> /tmp/dd.log |
            nc -p "$_sport" -w 3 "$GATEWAY" "$SINK_HOSTPORT"
    ) &
    _cpid=$!

    _i=0
    while [ $_i -lt 600 ]; do
        _b=$(tc_class_bytes "$_cls")
        [ "${_b:-0}" -ge 262144 ] && break
        kill -0 "$_cpid" 2> /dev/null || break
        sleep 0.05
        _i=$((_i + 1))
    done
    if ! kill -0 "$_cpid" 2> /dev/null; then
        bench_note "control: dd|nc exited before 256 KiB reached the class (sent=${_b:-0})"
        bench_row control n=0 m=0 profile=control mib="$_mib" rc=1
        wait "$_cpid" 2> /dev/null
        return 1
    fi
    _b0=$(tc_class_bytes "$_cls")
    _u0=$(up_now)
    sleep "$P_window"
    _b1=$(tc_class_bytes "$_cls")
    _u1=$(up_now)
    _mb=$(awk -v a="$_b0" -v b="$_b1" -v x="$_u0" -v y="$_u1" \
        'BEGIN { t = y - x; if (t <= 0) t = 1; printf "%.2f", (b - a) * 8 / 1000000 / t }')

    # Completion: the class must have carried the whole volume. 90 s covers
    # 40 MiB at 4 Mbit/s with margin.
    _i=0
    _want=$((_mib * 1048576))
    while [ $_i -lt 3000 ]; do
        _b=$(tc_class_bytes "$_cls")
        [ "${_b:-0}" -ge "$_want" ] && break
        kill -0 "$_cpid" 2> /dev/null || break
        sleep 0.05
        _i=$((_i + 1))
    done
    _b2=$(tc_class_bytes "$_cls")
    T_END=$(up_now)
    T_WALL=$(awk -v a="$T_START" -v b="$T_END" 'BEGIN { printf "%.3f", b - a }')
    cpu_end
    wait "$_cpid" 2> /dev/null
    _rc=$?
    _done=0
    [ "${_b2:-0}" -ge "$_want" ] && _done=1
    bench_note "control: class=1:$_cls sport=$_sport class_bytes=${_b2:-0} want=$_want done=$_done"
    bench_row control n=0 m=0 profile=control mib="$_mib" control_mbit="$_mb" \
        goodput_mbit="$_mb" app_mbit="$_mb" wall_s="$T_WALL" \
        wire_bytes="${_b2:-0}" app_bytes="$_want" \
        wire_per_app=$(awk -v w="${_b2:-0}" -v a="$_want" 'BEGIN { if (a > 0) printf "%.4f", w / a; else print 0 }') \
        cpu_sys_pct="$X_CSYS" cpu_softirq_pct="$X_CSOFT" cpu_total_pct="$X_CTOT" \
        kworker_pct="$X_KW" rc="$_rc" strict="$_done"
    CONTROL_MBIT=$_mb
    return 0
}

# --- scenarios --------------------------------------------------------------
bench_throughput()
{
    tc_setup || fatal "tc setup failed (htb + u32 + netem)"
    # One boot per N keeps each run short and avoids a module flush between
    # rows (observed to block after a large transfer). --control-mbit lets a
    # later boot reuse the control measured in the first one.
    if [ "$P_control" -eq 1 ]; then
        control_measure "$P_mib"
    else
        CONTROL_MBIT=$P_control_mbit
    fi
    for _n in $(echo "$P_nlist" | tr ',' ' '); do
        if xfer "$_n" 0 "$P_profile" "$P_dup" "$P_mib" "n$_n"; then
            _ratio=$(awk -v t="$X_MBIT" -v c="${CONTROL_MBIT:-0}" \
                'BEGIN { if (c > 0) printf "%.2f", t / c; else print 0 }')
            emit_xfer_row "n$_n" control_mbit="${CONTROL_MBIT:-0}" tunnel_mbit="$X_MBIT" ratio="$_ratio"
        else
            bench_row "n$_n" n="$_n" m=0 profile="$P_profile" mib="$P_mib" rc=1
        fi
    done
    tc_clear
}

bench_profile()
{
    tc_setup || fatal "tc setup failed"
    for _p in $(echo "$P_profiles" | tr ',' ' '); do
        if xfer 4 1 "$_p" "$P_dup" "$P_mib" "profile-$_p"; then
            emit_xfer_row "profile-$_p"
        else
            bench_row "profile-$_p" n=4 m=1 profile="$_p" mib="$P_mib" rc=1
        fi
    done
    tc_clear
}

bench_loss()
{
    tc_setup || fatal "tc setup failed"
    for _ppm in $(echo "$P_loss" | tr ',' ' '); do
        if xfer 4 0 raw "$P_dup" "$P_mib" "loss-$_ppm" "" "$_ppm"; then
            _dropped=$(awk -v p_car="$PC_CARRIER" -v p_drop="$PC_DROPPED" \
                '$1 == 2 && ($p_car == 1 || $p_car == 2) { s += $p_drop } END { print s + 0 }' "$PEERS")
            bench_note "row=loss-$_ppm: injector dropped $_dropped records on carriers 1,2"
            emit_xfer_row "loss-$_ppm" drop_ppm="$_ppm" dropped_by_ppm="$_dropped"
        else
            bench_row "loss-$_ppm" n=4 m=0 profile=raw mib="$P_mib" drop_ppm="$_ppm" rc=1
        fi
    done
    tc_clear
}

# --- latency ----------------------------------------------------------------
# Two public connections per boot is not possible: the module resets the
# second one (observed, ECONNRESET on its first read). So the clean and lossy
# phases share one connection: tbt_lat runs phase 1, touches a marker, and
# waits for a go file; this script arms the injector in between.
lat_parse()
{
    # $1 = raw tbt_lat output, $2 = phase number. Sets LAT_KV.
    _line=$(printf '%s\n' "$1" | grep "^lat phase=$2 " | tail -n 1)
    LAT_KV=
    [ -n "$_line" ] || return 0
    for _f in $_line; do
        case $_f in
        phase=*) ;;
        complete=* | min_us=* | p50_us=* | p90_us=* | p95_us=* | p99_us=* | \
            p999_us=* | max_us=* | mean_us=* | over5ms=* | over20ms=* | hist=* | \
            outliers=* | tail_n=* | tail_min_us=* | tail_p50_us=* | tail_p90_us=* | \
            tail_p99_us=* | tail_max_us=* | err=* | failed_at=*)
            LAT_KV="$LAT_KV lat_$_f"
            ;;
        *=*) LAT_KV="$LAT_KV $_f" ;;
        esac
    done
}
lat_ok()
{
    case $LAT_KV in *"lat_complete=1"*) return 0 ;; esac
    return 1
}
bench_latency()
{
    NETEM_ARGS=$(echo "$P_netem" | tr '|' ' ')
[ "$NETEM_ARGS" = none ] && NETEM_ARGS=
    tc_setup || fatal "tc setup failed"

    _out=$(/bin/tbt_lat "$GATEWAY" "$ECHO_HOSTPORT" "$P_iters" "$P_bytes" \
        "$((CTRL_SPORT_BASE + 4))" 30 2>&1)
    _rc=$?
    bench_note "lat direct: rc=$_rc raw=$(printf '%s' "$_out" | tr '\n' '|')"
    lat_parse "$_out" 1
    if lat_ok; then _r=0; else _r=1; fi
    bench_row lat-direct n=0 m=0 profile=direct iters="$P_iters" \
        bytes="$P_bytes" $LAT_KV rc="$_r"

    flush_and_wait
    configure 4 0 raw 0 || fatal "latency tunnel rejected"
    sleep 1

    rm -f /tmp/lat_marker /tmp/lat_go /tmp/lat.out
    /bin/tbt_lat 127.0.0.1 "$PUB_PORT" "$P_iters" "$P_bytes" 0 8 \
        "$P_loss_iters" /tmp/lat_marker /tmp/lat_go > /tmp/lat.out 2>&1 &
    _lp=$!
    _i=0
    # Phase 1 is ITERS round trips (about 1.3 ms each here); wait long enough
    # for 10k iterations, and stop early if the client died.
    while [ ! -e /tmp/lat_marker ] && kill -0 "$_lp" 2> /dev/null && [ $_i -lt 3000 ]; do
        sleep 0.02
        _i=$((_i + 1))
    done
    _armed=0
    if [ -e /tmp/lat_marker ]; then
        echo 'carrier 1 drop_ppm 10000' > "$PEERS"
        echo 'carrier 2 drop_ppm 10000' > "$PEERS"
        _armed=1
        bench_note "lat tunnel: phase 2 armed at t=$(up_now) retx_before=$(peer_retx_max 2)"
    else
        bench_note "lat tunnel: phase 1 ended before the marker"
    fi
    : > /tmp/lat_go
    wait "$_lp"
    _rc=$?
    _out=$(cat /tmp/lat.out)
    bench_note "lat tunnel: rc=$_rc raw=$(printf '%s' "$_out" | tr '\n' '|')"
    lat_parse "$_out" 1
    if lat_ok; then _r=0; else _r=1; fi
    bench_row lat-tunnel-n4 n=4 m=0 profile=raw iters="$P_iters" \
        bytes="$P_bytes" $LAT_KV rc="$_r"
    lat_parse "$_out" 2
    _dropped=$(awk -v p_car="$PC_CARRIER" -v p_drop="$PC_DROPPED" \
        '$1 == 2 && ($p_car == 1 || $p_car == 2) { s += $p_drop } END { print s + 0 }' "$PEERS")
    _hd=$(( $(tunnel_stat 2 holes_declared) - _hd0 ))
    _hr=$(( $(tunnel_stat 2 holes_repaired) - _hr0 ))
    _hu=$(( $(tunnel_stat 2 holes_unrecoverable) - _hu0 ))
    _stall=$(stat_max rx_max_stall_us)
    : "${_hd:=0}" "${_hr:=0}" "${_hu:=0}" "${_stall:=0}"
    if [ "$_armed" -eq 1 ] && lat_ok; then _r=0; else _r=1; fi
    bench_row lat-tunnel-n4-loss1pct n=4 m=0 profile=raw drop_ppm=10000 \
        iters="$P_loss_iters" bytes="$P_bytes" dropped_by_ppm="$_dropped" \
        holes_declared="$_hd" holes_repaired="$_hr" holes_unrecoverable="$_hu" \
        rx_max_stall_us="$_stall" $LAT_KV rc="$_r"
    bench_note "lat loss: t=$(up_now) holes=$(tunnel_stat 2 holes_declared)/$(tunnel_stat 2 holes_repaired)/$(tunnel_stat 2 holes_unrecoverable) stall_us=$(tunnel_stat 2 rx_max_stall_us) retx_ppm_max=$(peer_retx_max 2) depth=$(tunnel_stat 2 reorder_max_depth)"
    bench_note "lat loss peers: $(grep -v '^#' "$PEERS" | tr '\n' '|')"
    tc_clear
}

# --- memory -----------------------------------------------------------------
slab_top()
{
    awk '
        FNR == NR { if (FNR > 2 && $1 != "#") before[$1] = $3 * $4; next }
        FNR > 2 && $1 != "#" {
            d = $3 * $4 - before[$1]
            if (d > 0) printf "%s:%d\n", $1, d / 1024
        }' /tmp/slab.before /tmp/slab.after 2> /dev/null |
        sort -t: -k2 -rn | head -5 | tr '\n' ';'
}
bench_memory()
{
    tc_setup || fatal "tc setup failed"
    _before=$(mem_used)
    _rss0=$(proc_rss)
    _slab0=$(slab_used)
    cat /proc/slabinfo > /tmp/slab.before 2> /dev/null
    memsampler_start
    xfer 4 1 raw 0 "$P_mib" mem
    memsampler_stop
    cat /proc/slabinfo > /tmp/slab.after 2> /dev/null
    _after=$(mem_used)
    _slab1=$(slab_used)
    _peak=$(m_max 2)
    _rsspeak=$(m_max 3)
    _slabpeak=$(m_max 4)
    _top=$(slab_top)
    emit_xfer_row mem mem_before_kb="$_before" mem_peak_kb="$_peak" \
        mem_after_kb="$_after" proc_rss_before_kb="$_rss0" proc_rss_peak_kb="$_rsspeak" \
        slab_before_kb="$_slab0" slab_peak_kb="$_slabpeak" slab_after_kb="$_slab1" \
        slab_top="$_top" notes=no_private_kmem_cache
    tc_clear
}

bench_scale()
{
    tc_setup || fatal "tc setup failed"
    for _n in $(echo "$P_nlist" | tr ',' ' '); do
        if xfer "$_n" 0 raw "$P_dup" "$P_mib" "n$_n"; then
            _cf=$(tunnel_stat 2 connect_fail)
            _af=$(tunnel_stat 2 alloc_fail)
            _lost=$(tunnel_stat 2 lost)
            _rep=$(tunnel_stat 2 replaced)
            : "${_cf:=0}" "${_af:=0}" "${_lost:=0}" "${_rep:=0}"
            emit_xfer_row "n$_n" connect_fail="$_cf" alloc_fail="$_af" \
                carrier_lost="$_lost" carrier_replaced="$_rep"
        else
            bench_row "n$_n" n="$_n" m=0 profile=raw mib="$P_mib" rc=1
        fi
    done
    tc_clear
}

# --- end-of-row diagnostics -------------------------------------------------
# The complete c3 and live lines for both tunnels, every peers line, the top
# kworker with its stack, and the last dmesg lines. Printed as BENCHSTATS so
# the CSV writer ignores them and the console keeps the raw text.
bench_stats()
{
    awk '$1 == "tunnel" && ($2 == 1 || $2 == 2) && ($3 == "c3" || $3 == "live") {
             print "BENCHSTATS stats " $0 }' /proc/net/tbtun/stats
    awk '{ print "BENCHSTATS peers " $0 }' /proc/net/tbtun/peers
    # Top three kworkers by CPU since boot, four stack samples each: one
    # sample usually lands between work items and shows only worker_thread.
    awk '
        {
            c = substr($0, index($0, "(") + 1)
            c = substr(c, 1, index(c, ")") - 1)
            if (c !~ /^kworker/) next
            rest = substr($0, index($0, ")") + 2)
            split(rest, a, " ")
            print a[12] + a[13], $1, c
        }' /proc/[0-9]*/stat 2> /dev/null | sort -rn | head -n 3 |
    while read -r _kt _kp _kc; do
        _ks=
        _wc=$(cat "/proc/$_kp/wchan" 2> /dev/null)
        [ -n "$_wc" ] || _wc=-
        _i=0
        while [ $_i -lt 10 ]; do
            _s=$(tr '\n' '|' < "/proc/$_kp/stack" 2> /dev/null)
            [ -n "$_s" ] && _ks="$_ks[$_i]$_s "
            _i=$((_i + 1))
            sleep 0.01
        done
        [ -n "$_ks" ] || _ks=-
        printf 'BENCHSTATS kworker pid=%s comm=%s ticks=%s wchan=%s stack=%s\n' \
            "$_kp" "$_kc" "$_kt" "$_wc" "$_ks"
    done
    _dm=$(dmesg 2> /dev/null | tail -n 40)
    case $_dm in
    '') printf 'BENCHSTATS dmesg -\n' ;;
    *) printf '%s\n' "$_dm" | awk '{ print "BENCHSTATS dmesg " $0 }' ;;
    esac
}

# --- wan: one raw stream over the measured 218 ms / 17 Mbit path ------------
# rx_mbit is the echo direction's rate into the burst's socket; goodput_mbit
# is the carrier wire rate over the same window. inflight_sum is the sampler's
# peak sum over the near carriers and tx_window the peak the module reported,
# so the row shows whether the sender window covers the path's BDP.
bench_wan()
{
    tc_setup_wan || fatal "wan tc setup failed (htb + netem + u32)"
    bench_note "wan: ${P_wan_mbit}mbit per carrier port class, ${P_wan_delay}ms netem per direction"
    _tw=${P_tx_window:-0}
    for _n in $(echo "$P_nlist" | tr ',' ' '); do
        # RTO is SRTT + 4*RTTVAR with a 200 ms floor, so ~300 ms on this
        # path; a 1500 ms hole budget is 3-5x that and still leaves room for
        # a repair, and 3000 ms of silence is a real stall, not jitter.
        _stall=3000
        _x="carrier_stall_ms=$_stall keepalive=2000"
        [ "$_tw" -gt 0 ] && _x="$_x tx_window_bytes=$_tw"
        if xfer "$_n" 0 "$P_profile" "$P_dup" "$P_mib" "wan-n$_n" \
            "$_x"; then
            _win=$(tunnel_stat 2 tx_window)
            _rttmean=$(tunnel_stat 2 rtt_mean_us)
            _rttvar=$(tunnel_stat 2 rttvar_us)
            _rttmaxc3=$(tunnel_stat 2 rtt_max_us)
            _wkv= _rkv= _ckv=
            [ -n "$_win" ] && _wkv="tx_window=$X_WIN"
            [ -n "$_rttmean" ] && _rkv="rtt_mean_us=$_rttmean rttvar_us=$_rttvar rtt_max_us=$_rttmaxc3"
            # The row-end peers snapshot: the module reports rtt_us=0 while
            # the stream is busy and only fills it in when the carrier goes
            # quiet, so the across-carrier values come from here, not from
            # the 250 ms sampler.
            _rttmaxp=$(peer_rtt_max 2)
            _rttmin=$(peer_rtt_min 2)
            _ncar=$(peers_total 2)
            _deliv=0
            [ "$PC_RATE" -gt 0 ] && _deliv=$(peer_sum 2 "$PC_RATE")
            : "${_rttmaxp:=0}" "${_rttmin:=0}" "${_ncar:=0}" "${_deliv:=0}"
            if [ "$_rttmaxp" -gt 0 ]; then
                _ckv="$_ckv car_srtt_ms=$(awk -v u="$_rttmaxp" 'BEGIN { printf "%.1f", u / 1000 }')"
                _ckv="$_ckv rtt_min_us=$_rttmin n_carriers=$_ncar"
            fi
            if [ "$PC_RATE" -gt 0 ]; then
                _ckv="$_ckv car_delivery_mbps=$(awk -v r="$X_DELIV" 'BEGIN { printf "%.2f", r * 8 / 1000000 }')"
                _ckv="$_ckv car_cwnd_kb=$(awk -v b="$X_CWND" 'BEGIN { printf "%.1f", b / 1024 }')"
                _ckv="$_ckv car_snd_wnd_kb=$(awk -v b="$X_SNDW" 'BEGIN { printf "%.1f", b / 1024 }')"
                if [ "$_deliv" -gt 0 ]; then
                    _ckv="$_ckv sum_delivery_mbps=$(awk -v r="$_deliv" 'BEGIN { printf "%.2f", r * 8 / 1000000 }')"
                    if [ "$X_WIN" -gt 0 ] && [ -n "$_rttmean" ] && [ "$_rttmean" -gt 0 ]; then
                        _bdp=$(awk -v u="$_rttmean" -v r="$_deliv" \
                            'BEGIN { printf "%.1f", u * r / 1000000 / 1024 }')
                        _cov=$(awk -v w="$X_WIN" -v u="$_rttmean" -v r="$_deliv" \
                            'BEGIN { b = u * r / 1000000; if (b > 0) printf "%.2f", w / b; else print 0 }')
                        # coverage and k_eff are the same quantity: how many
                        # mean BDPs the peak window covers.
                        _ckv="$_ckv mean_bdp_kb=$_bdp coverage=$_cov k_eff=$_cov"
                    fi
                fi
            fi
            emit_xfer_row "wan-n$_n" wan_mbit="$P_wan_mbit" \
                wan_delay_us="$((P_wan_delay * 1000))" rx_mbit="$X_RX_MBIT" \
                inflight_sum="$X_INFL_SUM" tx_ack="$(tunnel_stat 2 tx_ack)" \
                carrier_lost="$(tunnel_stat 2 lost)" \
                win_block="$(tunnel_stat 2 win_block)" \
                pump_hw_armed="$(tunnel_stat 2 pump_hw_armed)" \
                pump_hw_fired="$(tunnel_stat 2 pump_hw_fired)" \
                car_sndbuf="$(tunnel_stat 2 car_sndbuf)" \
                car_rcvbuf="$(tunnel_stat 2 car_rcvbuf)" \
                inflight_over_window="$X_OVER" \
                hole_budget_ms="$P_hole_budget" carrier_stall_ms="$_stall" \
                $_wkv $_rkv $_ckv
            bench_stats
        else
            bench_row "wan-n$_n" n="$_n" m=0 profile="$P_profile" mib="$P_mib" rc=1
        fi
    done
    tc_clear
}

# --- flush-hang: does `echo flush` return after a completed transfer? -------
# The known defect: it does not. The write runs in a subshell with a 5 s
# bound; on a hang the init records the blocked task's wchan and kernel stack
# and continues, so the row still reaches the CSV.
bench_flush_hang()
{
    tc_setup || fatal "tc setup failed"
    if ! ( xfer 4 0 raw 0 "$P_mib" flush-pre ); then
        bench_row flush-hang mib="$P_mib" hung=1 flush_s=0 verdict=FAIL \
            wchan=setup_failed stack=- rc=1
        return 0
    fi
    _t0=$(up_now)
    ( echo flush > "$CFG" ) &
    _fp=$!
    _i=0
    while kill -0 "$_fp" 2> /dev/null && [ $_i -lt 100 ]; do
        sleep 0.05
        _i=$((_i + 1))
    done
    _t1=$(up_now)
    _secs=$(awk -v a="$_t0" -v b="$_t1" 'BEGIN { printf "%.2f", b - a }')
    _hung=0 _verdict=PASS _wchan=- _stack=-
    if kill -0 "$_fp" 2> /dev/null; then
        _hung=1 _verdict=FAIL
        _wchan=$(cat "/proc/$_fp/wchan" 2> /dev/null)
        _stack=$(tr '\n' ';' < "/proc/$_fp/stack" 2> /dev/null | tr ' ' '_')
        _syscall=$(cat "/proc/$_fp/syscall" 2> /dev/null | tr ' ' '_')
        bench_note "flush-hang: pid=$_fp wchan=$_wchan syscall=$_syscall stack=$_stack"
        kill -9 "$_fp" 2> /dev/null
    fi
    : "${_wchan:=-}" "${_stack:=-}"
    bench_row flush-hang mib="$P_mib" hung="$_hung" flush_s="$_secs" \
        verdict="$_verdict" wchan="$_wchan" stack="$_stack" rc=0
}

# --- second-connection: A active, B concurrent, C after A closes -----------
bench_second_conn()
{
    tc_setup || fatal "tc setup failed"
    flush_and_wait
    configure 4 0 raw 0 || fatal "second-connection tunnel rejected"
    sleep 1
    _out=$(/bin/tbt_conn 127.0.0.1 "$PUB_PORT" 3000 2>&1)
    _rc=$?
    bench_note "second-conn: rc=$_rc raw=$(printf '%s' "$_out" | tr '\n' '|')"
    _kv=
    for _f in $_out; do
        case $_f in
        conn | while_active=* | errno_active=* | ms_active=* | after_close=* | \
            errno_after=* | ms_after=*)
            [ "$_f" = conn ] && continue
            _kv="$_kv $_f"
            ;;
        esac
    done
    case $_out in
    *"while_active=ok "*"after_close=ok"*) _v=PASS ;;
    *) _v=FAIL ;;
    esac
    bench_row second-connection n=4 m=0 profile=raw $_kv verdict="$_v" rc="$_rc"
}

# --- hole-cost: one guaranteed hole per request that lands on carrier 1 ----
# carrier 1 drops every DATA frame at the write boundary; the retransmit goes
# to another path, so each affected request pays exactly one hole. The
# app-visible latency distribution (histogram + every sample over 5 ms) is
# the per-hole cost distribution.
bench_hole_cost()
{
    tc_setup || fatal "tc setup failed"
    flush_and_wait
    configure 4 0 raw 0 || fatal "hole-cost tunnel rejected"
    sleep 1
    echo 'carrier 1 drop_ppm 1000000' > "$PEERS" || bench_note "hole-cost: arm rejected"
    _d0=$(awk -v p_car="$PC_CARRIER" -v p_drop="$PC_DROPPED" \
        '$p_car == 1 { s += $p_drop } END { print s + 0 }' "$PEERS")
    _hd0=$(stat_sum holes_declared) _hr0=$(stat_sum holes_repaired)
    _hu0=$(stat_sum holes_unrecoverable)
    : "${_hd0:=0}" "${_hr0:=0}" "${_hu0:=0}"
    _out=$(/bin/tbt_lat 127.0.0.1 "$PUB_PORT" "$P_hole_iters" "$P_bytes" 0 30 2>&1)
    _rc=$?
    _d1=$(awk -v p_car="$PC_CARRIER" -v p_drop="$PC_DROPPED" \
        '$p_car == 1 { s += $p_drop } END { print s + 0 }' "$PEERS")
    _holes=$((_d1 - _d0))
    bench_note "hole-cost: rc=$_rc dropped=$_holes raw=$(printf '%s' "$_out" | tr '\n' '|')"
    lat_parse "$_out" 1
    if lat_ok; then _r=0; else _r=1; fi
    _hd=$(( $(tunnel_stat 2 holes_declared) - _hd0 ))
    _hr=$(( $(tunnel_stat 2 holes_repaired) - _hr0 ))
    _hu=$(( $(tunnel_stat 2 holes_unrecoverable) - _hu0 ))
    _stall=$(stat_max rx_max_stall_us)
    : "${_hd:=0}" "${_hr:=0}" "${_hu:=0}" "${_stall:=0}"
    bench_row hole-cost n=4 m=0 profile=raw drop_ppm=1000000 \
        iters="$P_hole_iters" bytes="$P_bytes" dropped_by_ppm="$_holes" \
        holes_declared="$_hd" holes_repaired="$_hr" holes_unrecoverable="$_hu" \
        rx_max_stall_us="$_stall" $LAT_KV rc="$_r"
}

