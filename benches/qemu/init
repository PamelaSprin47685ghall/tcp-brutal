echo_pid=$!
nc -lk -p "$SINK_PORT" > /dev/null 2>&1 &
sink_pid=$!
sleep 0.5
kill -0 "$echo_pid" 2> /dev/null || fatal "tbt_echo did not start"
kill -0 "$sink_pid" 2> /dev/null || fatal "sink nc did not start"

bench_note "guest $(uname -r) scenario=$P_scenario mib=$P_mib netem='$NETEM_ARGS'"
bench_note "clock ticks=$(getconf CLK_TCK 2> /dev/null || echo 100) ncpu=$(grep -c '^cpu[0-9]' /proc/stat)"
bench_note "module $(grep '^tbtun ' /proc/modules | awk '{print $1, $2}') $(head -n 1 /proc/net/tbtun/stats)"
bench_note "tc=$(command -v tc) $(ls -l /bin/tc 2>&1) version=$(/bin/tc -V 2>&1 | head -n 1)"

# The scenario runs in a subshell: an arithmetic or shell error in the
# harness must not exit PID 1 (the kernel turns that into "Attempted to kill
# init", which hides the real failure).
(
    case $P_scenario in
    throughput) bench_throughput ;;
    profile) bench_profile ;;
    loss) bench_loss ;;
    latency) bench_latency ;;
    memory) bench_memory ;;
    scale) bench_scale ;;
