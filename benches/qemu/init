done
/bin/busybox ip link show eth0 > /dev/null 2>&1 || fatal "no eth0 (run without --no-net)"
/bin/busybox ip link set eth0 up
/bin/busybox ip addr add "$GUEST_IP/24" dev eth0 2> /dev/null
/bin/busybox ip route add default via "$GATEWAY" 2> /dev/null

# The strict send-then-read phase holds the echoed volume it has not read yet;
# at the default ~6 MB receive buffer 40 MiB would deadlock and look like a
# tunnel stall. Same setting probe I uses.
echo 67108864 > /proc/sys/net/core/rmem_max 2> /dev/null
echo 67108864 > /proc/sys/net/core/wmem_max 2> /dev/null
echo "4096 262144 67108864" > /proc/sys/net/ipv4/tcp_rmem 2> /dev/null
echo "4096 262144 67108864" > /proc/sys/net/ipv4/tcp_wmem 2> /dev/null

insmod /tbtun.ko debug=0 debug_loss=1 || fatal "insmod tbtun.ko"
[ -e "$CFG" ] || fatal "$CFG missing after load"
echo "ports $PORTBLOCK_LO-$((PORTBLOCK_LO + PORTBLOCK_MOD - 1))" > "$PORTS" || fatal "ports directive rejected"
peer_cols_init

# The echo peer (tunnel target and direct latency peer) and the control sink.
