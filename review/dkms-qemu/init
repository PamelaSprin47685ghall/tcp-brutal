#!/bin/sh
# init - PID 1 in the DKMS acceptance guest.
#
# The guest boots the same kernel the module is built against, but has no
# writable root of its own. It therefore assembles a chroot from read-only 9p
# exports of the host's /usr, /etc and /home plus a writable ext4 image for the
# four directories an install touches:
#
#   /usr/lib/modules/<rel>  module tree (also the DKMS install_tree)
#   /usr/src                DKMS stage (source_tree)
#   /var/lib/dkms           DKMS tree
#   /tmp, /var, /root       scratch, on the chroot's tmpfs
#
# Everything the host exports is mounted read-only; nothing on the host is
# written except the artifacts directory, which is exported read-write and is
# where guest-test.sh copies its evidence.
set -u

REL=$(uname -r)
PATH=/bin
export PATH

say() {
    printf 'INIT: %s\n' "$*"
}

die() {
    printf 'INIT: FAIL: %s\n' "$*"
    printf 'DKMS_RESULT FAIL setup: %s\n' "$*"
    poweroff -f
}

mount -t proc proc /proc || die "mount /proc"
mount -t sysfs sysfs /sys || die "mount /sys"
mount -t devtmpfs devtmpfs /dev 2> /dev/null || true
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2> /dev/null || true
mkdir -p /run
mount -t tmpfs -o size=64M tmpfs /run || die "mount /run"
mount -t tmpfs -o size=256M tmpfs /tmp || die "mount /tmp"

# 9p over virtio, and its two dependencies. Loaded from the kernel's own
# module tree, so vermagic matches the running kernel exactly.
for m in netfs 9pnet 9pnet_virtio 9p; do
    insmod "/mods/$m.ko" || die "insmod $m"
done
say "9p modules loaded: $(cut -d' ' -f1 /proc/modules | tr '\n' ' ')"

mount -t 9p -o trans=virtio,version=9p2000.L,msize=1048576,cache=loose \
    hostroot /host || die "mount hostroot 9p export"
say "host root read-only at /host"

mount -t tmpfs -o size=256M tmpfs /newroot || die "mount /newroot"
mkdir -p /newroot/usr /newroot/etc /newroot/home /newroot/proc /newroot/sys \
    /newroot/dev /newroot/run /newroot/tmp /newroot/root /newroot/opt \
    /newroot/mnt/disk /newroot/out /newroot/var/lib/dkms
ln -s usr/bin /newroot/bin
ln -s usr/bin /newroot/sbin
ln -s usr/lib /newroot/lib
ln -s usr/lib /newroot/lib64

# The host userland: read-only, so the guest cannot touch it.
mount --bind /host/usr /newroot/usr || die "bind /usr"
mount --bind /host/etc /newroot/etc || die "bind /etc"
mount --bind /host/home /newroot/home || die "bind /home"

# The writable pieces, from the ext4 image.
mount -t ext4 /dev/vda /newroot/mnt/disk || die "mount /dev/vda (ext4 image)"
mount --bind /newroot/mnt/disk/src /newroot/usr/src || die "bind /usr/src"
mount --bind /newroot/mnt/disk/dkms /newroot/var/lib/dkms || die "bind /var/lib/dkms"
mount --bind "/newroot/mnt/disk/modules/$REL" "/newroot/usr/lib/modules/$REL" ||
    die "bind /usr/lib/modules/$REL"
# What a distribution ships: /lib/modules/<rel>/build points at the headers.
ln -sfn /mnt/disk/headers "/newroot/usr/lib/modules/$REL/build"
say "chroot assembled: /lib/modules/$REL/build -> /mnt/disk/headers"

mount -t proc proc /newroot/proc || die "mount /newroot/proc"
mount --bind /sys /newroot/sys || die "bind /sys"
mount --bind /dev /newroot/dev || die "bind /dev"
mount -t tmpfs -o size=64M tmpfs /newroot/run || die "mount /newroot/run"

# Evidence goes back to the host through this read-write export.
mount -t 9p -o trans=virtio,version=9p2000.L,msize=262144 \
    out /newroot/out || say "warning: no 'out' 9p export; console only"

mkdir -p /newroot/opt/dkms/bin
cp /dkms /newroot/opt/dkms/bin/dkms || die "install dkms into the chroot"
chmod 0755 /newroot/opt/dkms/bin/dkms
cp /guest-test.sh /newroot/opt/guest-test.sh || die "install guest-test.sh"
chmod 0755 /newroot/opt/guest-test.sh

say "entering chroot"
chroot /newroot /bin/bash /opt/guest-test.sh
rc=$?
printf 'INIT: guest-test exited %d\n' "$rc"

# The artifacts live on a 9p export; flush them before the poweroff.
sync
poweroff -f
sleep 5
