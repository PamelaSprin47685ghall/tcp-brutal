+/* Bring-up tracing for the carrier window between a completed TCP handshake
+ * and the HELLO reaching the wire. pr_info, never pr_debug: the field hosts
+ * do not enable dynamic debug, and the value of these lines is that the last
+ * one on the console is the last step that ran before a hang or a panic. The
+ * unique prefix lets a capture filter them out of the module's ordinary
+ * output; function, CPU and pid are on every line because a step that never
+ * logs is the step that did not return. Keep the call sites one-shot or
+ * rate-bounded: logging must not move the timing it measures. */
+#define TBT_DIAG(fmt, ...)                                            \
+    pr_info("tbtun-diag: %s cpu=%u pid=%d " fmt "\n", __func__,       \
+            raw_smp_processor_id(), task_pid_nr(current),             \
+            ##__VA_ARGS__)
