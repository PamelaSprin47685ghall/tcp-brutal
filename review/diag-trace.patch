+#define TBT_DIAG_WARN(fmt, ...)                                       \
+    pr_warn("tbtun-diag: %s cpu=%u pid=%d " fmt "\n", __func__,       \
+            raw_smp_processor_id(), task_pid_nr(current),             \
+            ##__VA_ARGS__)
